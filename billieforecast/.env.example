# Copied to .env, these are loaded by this Python project from its working directory.
BILLIEFORECAST_BACKEND=chronos
BILLIEFORECAST_MODEL_ID=amazon/chronos-2
BILLIEFORECAST_DEVICE=cpu
BILLIEFORECAST_CACHE_DIR=.cache/huggingface
BILLIEFORECAST_HOST=127.0.0.1
BILLIEFORECAST_PORT=8000
# Optional: clients must send X-API-Key when this value is set.
BILLIEFORECAST_API_KEY=

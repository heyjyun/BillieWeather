# BillieWeather identity API. Copy to .env for local development; set these in Render for production.
IDENTITY_ENV=development                      # development | test | production
DATABASE_URL=postgresql://localhost/billieweather_identity_compat   # production: the SAME Neon database as Rails
DB_POOL_MAX=5
PUBLIC_URL=http://localhost:8100              # production: https://<this-service>.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
TOKEN_HMAC_KEY=                               # production: >= 32 random characters (openssl rand -hex 32)
BCRYPT_COST=11                                # must match Devise stretches (11)
PWNED_CHECK=                                  # empty = on in production, off otherwise (same as Devise pwned_password)
REGISTRATION_ENABLED=true                     # set false when the website uses INVITATION_KEYS
MAIL_DELIVERY=outbox                          # postmark | outbox | memory
MAIL_OUTBOX_DIR=tmp/outbox
POSTMARK_API_TOKEN=
MAIL_FROM=
GOOGLE_CLIENT_ID=                             # Google OAuth "Web application" client
GOOGLE_CLIENT_SECRET=                         # authorized redirect URI: {PUBLIC_URL}/v1/google/callback
TRUSTED_PROXY_HOPS=0                          # Render: 1
LOG_LEVEL=INFO

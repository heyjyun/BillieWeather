{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nlae.dev/schema/nlae-1/manifest.json",
  "title": "NLAE capability manifest (protocol nlae/1)",
  "description": "What a host can do. Produced by ActionRegistry.manifest(); a backend in any language can load it to validate plans and to know each action's risk and confirmation level.",
  "type": "object",
  "required": ["protocol", "product", "version", "actions"],
  "properties": {
    "protocol": { "const": "nlae/1" },
    "product": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "version": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "description", "expressions", "params", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$" },
          "description": { "type": "string" },
          "expressions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "examples": { "type": "array", "items": { "type": "string" } },
          "fillers": { "type": "array", "items": { "type": "string" } },
          "risk": { "enum": ["none", "low", "medium", "high"] },
          "confirmation": { "enum": ["none", "confirm", "typed"] },
          "typedConfirmationParam": { "type": "string" },
          "undoable": { "type": "boolean" },
          "context": { "type": "array", "items": { "type": "object", "required": ["param", "requirement"], "properties": { "param": { "type": "string" }, "requirement": { "enum": ["optional", "reference"] } } } },
          "params": {
            "type": "array",
            "items": {
              "type": "object", "required": ["name", "type"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
                "type": { "enum": ["text", "enum", "entity", "number", "money", "date", "dateRange", "boolean"] },
                "required": { "type": "boolean" }, "description": { "type": "string" }, "entityKind": { "type": "string" },
                "options": { "type": "array", "items": { "type": "object", "required": ["value", "aliases"], "properties": { "value": { "type": "string" }, "aliases": { "type": "array", "items": { "type": "string" } } } } },
                "markers": { "type": "array", "items": { "type": "string" } }, "capture": { "enum": ["marker", "remainder", "quoted"] }, "contextKey": { "type": "string" },
                "default": {}, "min": { "type": "number" }, "max": { "type": "number" }, "maxLength": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}

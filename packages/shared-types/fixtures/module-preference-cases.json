{
  "$comment": "Replayed by clients/universal/test/modules.test.ts and test/models/finance/module_catalog_test.rb. 'sidebar' is the expected list of module ids in the sidebar, in catalog order. 'usable' (enabled) never depends on preferences: it is every module available on the surface, listed once per surface under 'usable_by_surface'. Choices stored with the legacy key 'enabled' mean the same as 'sidebarVisible'.",
  "usable_by_surface": {
    "web": ["transactions", "ai_assistant", "overview", "import", "receipts", "accounts", "categories", "budgets", "reports", "recurring", "forecast"],
    "app": ["transactions", "ai_assistant", "overview", "import", "receipts", "data_management", "accounts", "categories", "budgets", "reports", "recurring"]
  },
  "cases": [
    { "name": "new person on the website: minimal sidebar, everything built is usable", "surface": "web", "preferences": null,
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "new person in the app: minimal sidebar", "surface": "app", "preferences": { "format": 1, "modules": {} },
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "modules shown in the sidebar", "surface": "web",
      "preferences": { "format": 1, "modules": { "budgets": { "sidebarVisible": true, "changedAt": "2026-11-23T10:00:00Z" }, "accounts": { "sidebarVisible": true, "changedAt": "2026-11-23T10:00:01Z" } } },
      "sidebar": ["transactions", "ai_assistant", "accounts", "budgets"] },
    { "name": "choices saved before the rename (key 'enabled') are kept", "surface": "app",
      "preferences": { "format": 1, "modules": { "reports": { "enabled": true, "changedAt": "2026-11-23T10:00:00Z" }, "ai_assistant": { "enabled": false, "changedAt": "2026-11-23T10:00:00Z" } } },
      "sidebar": ["transactions", "reports"] },
    { "name": "a core module hidden from the sidebar", "surface": "app",
      "preferences": { "format": 1, "modules": { "ai_assistant": { "sidebarVisible": false, "changedAt": "2026-11-23T10:00:00Z" } } },
      "sidebar": ["transactions"] },
    { "name": "coming-soon modules never appear, whatever was stored", "surface": "web",
      "preferences": { "format": 1, "modules": { "goals": { "sidebarVisible": true, "changedAt": "x" }, "household": { "enabled": true, "changedAt": "x" }, "ledgers": { "sidebarVisible": true, "changedAt": "x" }, "multi_currency": { "sidebarVisible": true, "changedAt": "x" } } },
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "forecast is available on the website", "surface": "web",
      "preferences": { "format": 1, "modules": { "forecast": { "sidebarVisible": true, "changedAt": "2026-11-23T10:00:00Z" } } },
      "sidebar": ["transactions", "ai_assistant", "forecast"] },
    { "name": "forecast is not supported in the app, so it is never in the app sidebar", "surface": "app",
      "preferences": { "format": 1, "modules": { "forecast": { "sidebarVisible": true, "changedAt": "2026-11-23T10:00:00Z" } } },
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "unknown ids and malformed choices are ignored", "surface": "web",
      "preferences": { "format": 1, "modules": { "crypto_wallets": { "sidebarVisible": true, "changedAt": "x" }, "budgets": { "sidebarVisible": "yes" }, "reports": "on", "BAD ID": { "sidebarVisible": true } } },
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "an unknown format falls back to the defaults", "surface": "web",
      "preferences": { "format": 99, "modules": { "budgets": { "sidebarVisible": true, "changedAt": "x" } } },
      "sidebar": ["transactions", "ai_assistant"] },
    { "name": "settings is not a module and cannot be stored", "surface": "web",
      "preferences": { "format": 1, "modules": { "settings": { "sidebarVisible": false, "changedAt": "x" } } },
      "sidebar": ["transactions", "ai_assistant"] }
  ]
}

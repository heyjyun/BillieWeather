<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac mini only. Install with: ops/install-recovery-agent.sh  (a per-user LaunchAgent; no root, no daemon) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.billieweather.agent-recover</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>-lc</string><string>"__REPO__/ops/agent-run.sh" recover</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.billieweather-dev/logs/agent-recover.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.billieweather-dev/logs/agent-recover.log</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>

# Mac mini development defaults. Copy to ~/.billieweather-dev/env (outside the repo) and `source` it.
# Never put DATABASE_URL, Neon, Render, OpenAI or Postmark credentials here: development and tests use
# the isolated cluster from ops/dev-services.sh, and the release build only needs the two public URLs.
export BILLIE_DEV_ROOT="$HOME/Developer/BillieWeather"
export BILLIE_DEV_BRANCH=main
# bin/billie-local uses Homebrew postgresql@18 when present; set BILLIE_PG_BIN to override.
# Unattended agents (ops/agent-run.sh)
export BILLIE_AGENT_PERMISSION_MODE=acceptEdits
export BILLIE_AGENT_MAX_ATTEMPTS=12
export BILLIE_AGENT_LIMIT_WAIT=1800
# Release builds (ops/release-build.sh): the stable account servers the MacBook app will use.
# export BILLIE_API_URL=https://<stable-api-host>
# export BILLIE_IDENTITY_URL=https://<stable-identity-host>
# Optional, only once a Developer ID exists on this Mac:
# export BILLIE_SIGN_IDENTITY="Developer ID Application: <name> (<team>)"
# export BILLIE_NOTARY_PROFILE=<notarytool profile name>

<% content_for :title, t("billie.auth.reset_password") %>
<section class="bw-auth-wrap">
  <div class="bw-panel bw-auth-card">
    <p class="bw-eyebrow"><%= t("billie.auth.recovery_eyebrow") %></p>
    <h1><%= t("billie.auth.reset_password") %></h1>
    <p class="bw-muted"><%= t("billie.auth.reset_description") %></p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {class: "bw-form", method: :post, data: {turbo: false}}) do |form| %>
      <% if resource.errors.any? %><div class="bw-flash bw-flash-error" role="alert"><%= resource.errors.full_messages.to_sentence %></div><% end %>
      <div class="bw-field"><%= form.label :email, t("billie.auth.email") %><%= form.email_field :email, required: true, autocomplete: "email", autofocus: true %></div>
      <%= form.submit t("billie.auth.send_reset_link"), class: "bw-button bw-button-dark" %>
    <% end %>
    <div class="bw-auth-links"><%= link_to t("billie.auth.back_to_login"), new_user_session_path %><%= link_to t("billie.auth.create_an_account"), new_user_registration_path %></div>
  </div>
</section>

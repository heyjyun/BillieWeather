<% content_for :title, t("billie.auth.choose_password") %>
<section class="bw-auth-wrap">
  <div class="bw-panel bw-auth-card">
    <p class="bw-eyebrow"><%= t("billie.auth.fresh_start") %></p>
    <h1><%= t("billie.auth.choose_password") %></h1>
    <p class="bw-muted"><%= t("billie.auth.protect_workspace") %></p>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: {class: "bw-form", method: :put, data: {turbo: false}}) do |form| %>
      <% if resource.errors.any? %><div class="bw-flash bw-flash-error" role="alert"><%= resource.errors.full_messages.to_sentence %></div><% end %>
      <%= form.hidden_field :reset_password_token %>
      <div class="bw-field"><%= form.label :password, t("billie.auth.new_password") %><%= form.password_field :password, required: true, autocomplete: "new-password", autofocus: true, minlength: @minimum_password_length, maxlength: 128 %><small><%= t("billie.auth.password_hint", count: @minimum_password_length) %></small></div>
      <div class="bw-field"><%= form.label :password_confirmation, t("billie.auth.confirm_new_password") %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
      <%= form.submit t("billie.auth.update_password"), class: "bw-button bw-button-dark" %>
    <% end %>
    <div class="bw-auth-links"><%= link_to t("billie.auth.back_to_login"), new_user_session_path %></div>
  </div>
</section>

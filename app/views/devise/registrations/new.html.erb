<% content_for :title, "Create your account" %>
<section class="bw-auth-wrap">
  <div class="bw-panel bw-auth-card">
    <p class="bw-eyebrow">A CLEARER FINANCIAL FORECAST</p>
    <h1>Create your account</h1>
    <p class="bw-muted">Bring your finances into focus, one statement at a time.</p>
    <%= render "devise/shared/google_sign_in" %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {data: {turbo: false}}) do |form| %>
      <% if resource.errors.any? %><div class="bw-flash bw-flash-error" role="alert"><%= resource.errors.full_messages.to_sentence %></div><% end %>
      <div class="bw-form-field"><%= form.label :first_name %><%= form.text_field :first_name, required: true, autocomplete: "given-name", maxlength: 80 %></div>
      <div class="bw-form-field"><%= form.label :last_name %><%= form.text_field :last_name, required: true, autocomplete: "family-name", maxlength: 80 %></div>
      <div class="bw-form-field"><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
      <div class="bw-form-field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: @minimum_password_length, maxlength: 128 %><small>Use at least <%= @minimum_password_length %> characters and a unique password.</small></div>
      <div class="bw-form-field"><%= form.label :password_confirmation, "Confirm password" %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
      <%= form.submit "Create account", class: "bw-button bw-button-dark" %>
    <% end %>
    <p class="bw-auth-switch">Already have an account? <%= link_to "Log in", new_user_session_path %></p>
  </div>
</section>

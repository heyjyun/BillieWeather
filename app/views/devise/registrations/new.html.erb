<% content_for :title, t("billie.auth.create_your_account") %>
<section class="bw-auth-wrap">
  <div class="bw-panel bw-auth-card">
    <p class="bw-eyebrow"><%= t("billie.auth.signup_eyebrow") %></p>
    <h1><%= t("billie.auth.create_your_account") %></h1>
    <p class="bw-muted"><%= t("billie.auth.signup_description") %></p>
    <%= render "devise/shared/google_sign_in" %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: {data: {turbo: false}}) do |form| %>
      <% if resource.errors.any? %><div class="bw-flash bw-flash-error" role="alert"><%= resource.errors.full_messages.to_sentence %></div><% end %>
      <div class="bw-form-field bw-field"><%= form.label :nickname, t("billie.account.nickname_optional") %><%= form.text_field :nickname, autocomplete: "nickname", maxlength: 40, "aria-describedby": "user_nickname_help" %><small id="user_nickname_help"><%= t("billie.account.nickname_help") %></small></div>
      <div class="bw-form-field bw-field">
        <%= form.label :usage_region, t("billie.region.label") %>
        <%= usage_region_select(form) %>
        <small id="user_usage_region_help"><%= t("billie.region.help") %></small>
      </div>
      <div class="bw-form-field"><%= form.label :email, t("billie.auth.email") %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
      <div class="bw-form-field"><%= form.label :password, t("billie.auth.password") %><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: @minimum_password_length, maxlength: 128 %><small><%= t("billie.auth.unique_password_hint", count: @minimum_password_length) %></small></div>
      <div class="bw-form-field"><%= form.label :password_confirmation, t("billie.auth.confirm_password") %><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></div>
      <%= form.submit t("billie.auth.create_account"), class: "bw-button bw-button-dark" %>
    <% end %>
    <p class="bw-auth-switch"><%= t("billie.auth.already_have_account") %> <%= link_to t("billie.auth.log_in"), new_user_session_path %></p>
  </div>
</section>

<% languages = I18n.t('locale.locales') %>
<details class="bw-language-menu">
  <summary aria-label="<%= t('billie.layout.language') %>: <%= languages[I18n.locale] %>">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="4" ry="9"/><path d="M3 12h18"/></svg>
    <span><%= languages[I18n.locale] %></span><span aria-hidden="true">⌄</span>
  </summary>
  <nav class="bw-language-switcher" aria-label="<%= t('billie.layout.language') %>">
    <% languages.each do |locale, label| %>
      <%= link_to label, billie_language_path(locale), lang: locale, hreflang: locale,
        "aria-current": ("true" if I18n.locale.to_s == locale.to_s), data: {turbo: false} %>
    <% end %>
  </nav>
</details>

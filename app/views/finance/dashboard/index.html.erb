<% content_for :title, "Dashboard" %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">YOUR MONEY, IN FOCUS</span><h1>A clearer financial picture.</h1><p><%= finance_period(@snapshot) %> <span class="bw-dot-divider">·</span> <%= @profile.currency %></p></div><%= link_to finance_statements_path, class: "bw-button bw-button-dark" do %><%= finance_icon "upload", size: 17 %> Upload statement<% end %></div>
<div class="bw-metrics"><article class="bw-metric"><span>Total income <i class="bw-metric-symbol bw-positive"><%= finance_icon "down", size: 18 %></i></span><strong><%= finance_money(@snapshot[:income], @profile.currency) %></strong><small>Across imported statement dates</small></article><article class="bw-metric"><span>Total expenses <i class="bw-metric-symbol"><%= finance_icon "up", size: 18 %></i></span><strong><%= finance_money(@snapshot[:expenses], @profile.currency) %></strong><small>Transfers and excluded items omitted</small></article><article class="bw-metric"><span>Net cash flow <i class="bw-metric-symbol"><%= finance_icon "transactions", size: 18 %></i></span><strong class="<%= 'bw-positive' if @snapshot[:net].to_d >= 0 %>"><%= finance_money(@snapshot[:net], @profile.currency) %></strong><small>Income minus expenses</small></article><article class="bw-metric bw-metric-mint"><span>Current cash balance <i class="bw-metric-symbol"><%= finance_icon "wallet", size: 18 %></i></span><strong><%= finance_money(@profile.current_balance, @profile.currency) %></strong><%= link_to "Set your balance →", finance_forecast_path, class: "bw-metric-link" %></article></div>
<% if @snapshot[:transaction_count].zero? %>
  <section class="bw-welcome-card"><div class="bw-welcome-icon"><%= finance_icon "sun", size: 42 %></div><div><span class="bw-eyebrow">A FRESH START</span><h2>Your financial story starts here.</h2><p>Upload your first CSV or text-based PDF statement to see income, spending, and a cash flow forecast based on your own transactions.</p><%= link_to "Upload your first statement", finance_statements_path, class: "bw-button bw-button-dark" %><%= link_to "Download sample CSV", sample_finance_statements_path(format: :csv), class: "bw-text-link" %></div></section>
<% else %>
  <div class="bw-two-column"><section class="bw-panel"><div class="bw-panel-heading"><div><h2>Money in. Money out.</h2><p>Monthly totals from your imported transactions</p></div><div class="bw-legend"><span><i class="bw-legend-income"></i>Income</span><span><i class="bw-legend-expense"></i>Expenses</span></div></div><% monthly = @snapshot[:monthly].last(6); maximum = [monthly.flat_map { |month| [month[:income].to_f, month[:expenses].to_f] }.max.to_f, 1].max %><div class="bw-bar-chart" role="img" aria-label="Monthly income and expenses"><% monthly.each do |month| %><div class="bw-bar-group"><div class="bw-bars"><div class="bw-bar bw-bar-income" style="height:<%= [(month[:income].to_f / maximum * 100).round(2), 1].max %>%" title="Income: <%= finance_money(month[:income], @profile.currency) %>"></div><div class="bw-bar bw-bar-expense" style="height:<%= [(month[:expenses].to_f / maximum * 100).round(2), 1].max %>%" title="Expenses: <%= finance_money(month[:expenses], @profile.currency) %>"></div></div><span><%= finance_date(month[:month], "%b %Y") %></span></div><% end %></div><details class="bw-chart-details"><summary>View monthly figures</summary><% monthly.each do |month| %><p><%= finance_date(month[:month], "%b %Y") %>: income <%= finance_money(month[:income], @profile.currency) %> · expenses <%= finance_money(month[:expenses], @profile.currency) %></p><% end %></details></section><section class="bw-panel"><div class="bw-panel-heading"><div><h2>Where it goes</h2><p>Your expense categories</p></div><%= finance_icon "transactions" %></div><div class="bw-category-list"><% @snapshot[:categories].first(6).each_with_index do |category, index| %><div><div class="bw-category-row"><span><i class="bw-category-dot tone-<%= index % 4 %>"></i><%= category[:name] %></span><strong><%= finance_money(category[:amount], @profile.currency) %></strong></div><div class="bw-category-track"><span class="tone-<%= index % 4 %>" style="width:<%= [(@snapshot[:expenses].to_f.positive? ? category[:amount].to_f / @snapshot[:expenses].to_f * 100 : 0).round(2), 100].min %>%"></span></div></div><% end %><% if @snapshot[:categories].empty? %><p class="bw-muted">No categorized expenses yet.</p><% end %></div></section></div>
<% end %>
<div class="bw-two-column bw-two-column-bottom"><section class="bw-panel bw-panel-flush"><div class="bw-panel-heading"><div><h2>Recent transactions</h2><p><%= pluralize(@snapshot[:transaction_count], "transaction") %> in your financial picture</p></div><%= link_to "View all →", finance_transactions_path, class: "bw-text-link" %></div><% if @recent_transactions.any? %><%= render "finance/shared/transactions_table", transactions: @recent_transactions, currency: @profile.currency %><% else %><div class="bw-small-empty"><%= finance_icon "transactions", size: 28 %><p>Your latest transactions will appear here.</p></div><% end %></section><section class="bw-insight-promo"><span class="bw-feature-icon"><%= finance_icon "insights", size: 26 %></span><span class="bw-eyebrow">A FRESH PERSPECTIVE</span><h2>Let your numbers<br>tell you more.</h2><p>Explore spending observations and practical next steps. Organize transactions that may need a closer look at tax time.</p><%= link_to finance_insights_path, class: "bw-button bw-button-dark" do %>Explore insights <%= finance_icon "arrow", size: 17 %><% end %><% if @snapshot[:uncategorized_count].positive? %><small><%= pluralize(@snapshot[:uncategorized_count], "transaction") %> still need a category.</small><% end %></section></div>

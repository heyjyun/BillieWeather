<% content_for :title, t("billie.modules.names.overview") %>
<% if @filter_error %>
  <h1><%= t("billie.modules.names.overview") %></h1>
  <p id="dashboard-period-error" role="alert"><%= @filter_error %></p>
  <%= link_to t("billie.finance.ui.view_all_dates"), finance_dashboard_path %>
<% else %>
  <% context = {
    locale: I18n.locale, greeting: personal_greeting, today: finance_today, owner: current_user.finance_owner_uid,
    ledger: "web", ledgers: [{id: "web", name: current_user.cloud_database_name.presence || t("billie.overview.web_ledger")}],
    currency: @profile.currency, currencies: @currencies,
    accounts: @accounts.map { |a| {id: a.id.to_s, name: a.display_name, currency: a.currency.presence || @profile.currency} },
    initial: {currency: @currency, account: @account&.id.to_s, period: {preset: @period.preset, startDate: @period.start_date, endDate: @period.end_date}}
  } %>
  <% links = {
    transactions: finance_transactions_path, categories: finance_categories_path, accounts: finance_accounts_path,
    addSync: finance_add_sync_path, addAccount: new_finance_account_path, addEntry: new_finance_entry_path, import: finance_statements_path,
    forecast: finance_forecast_path, insight: finance_insights_path, bills: finance_recurring_rules_path,
    budget: finance_budgets_path, report: finance_report_path
  } %>
  <%= tag.div id: "financial-overview", data: {context: context.to_json, links: links.to_json, source: finance_dashboard_path(format: :json)} do %>
    <h1><%= t("billie.modules.names.overview") %></h1>
    <p id="dashboard-greeting" data-day-part="<%= Personalization.day_part(personal_time) %>"><%= personal_greeting %></p>
    <%= link_to t("billie.export.button"), finance_report_path(preset: @period.preset, start_date: @period.start_date, end_date: @period.end_date), id: "dashboard-export-report" unless @account || @currency != @profile.currency %>
    <%= link_to t("billie.modules.names.transactions"), finance_transactions_path %>
    <%= link_to t("billie.finance.ui.upload_statement"), finance_statements_path %>
  <% end %>
  <%= render "finance/dashboard/nickname_prompt" if show_nickname_prompt? %>
  <script src="/financial-overview.js" defer></script>
<% end %>

<% content_for :title, t("billie.finance.ui.dashboard") %>
<div class="bw-page-heading">
  <div>
    <span class="bw-eyebrow"><%= t("billie.finance.ui.your_money_in_focus") %></span>
    <h1><%= t("billie.finance.ui.a_clearer_financial_picture") %></h1>
    <p>
      <% if @date_filter_error %>
        <%= t("billie.finance.ui.date_range_not_applied") %>
      <% elsif @period.filtered? %>
        <%= finance_date(@period.start_date) %> – <%= finance_date(@period.end_date) %>
      <% else %>
        <%= finance_period(@snapshot) %>
      <% end %>
      <span class="bw-dot-divider">·</span> <%= @profile.currency %>
    </p>
  </div>
  <%= link_to finance_statements_path, class: "bw-button bw-button-dark" do %>
    <%= finance_icon "upload", size: 17 %> <%= t("billie.finance.ui.upload_statement") %>
  <% end %>
</div>

<section class="bw-dashboard-period" aria-labelledby="dashboard-period-heading">
  <div class="bw-dashboard-period-heading">
    <h2 id="dashboard-period-heading"><%= t("billie.finance.ui.time_period") %></h2>
    <p><%= t("billie.finance.ui.choose_the_dates_for_your_income_expenses_and_transactions") %></p>
  </div>
  <nav class="bw-period-presets" aria-label="<%= t("billie.finance.ui.dashboard_periods") %>">
    <% [[t("billie.finance.ui.all_time"), "all_time"], [t("billie.finance.ui.this_month"), "this_month"], [t("billie.finance.ui.last_month"), "last_month"], [t("billie.finance.ui.last_30_days"), "last_30_days"], [t("billie.finance.ui.this_year"), "this_year"], [t("billie.finance.ui.last_year"), "last_year"]].each do |label, preset| %>
      <%= link_to label, finance_dashboard_path(preset: preset), class: "bw-period-preset#{' is-active' if @period.preset == preset}", aria: {current: (@period.preset == preset ? "true" : nil)} %>
    <% end %>
  </nav>
  <%= form_with url: finance_dashboard_path, method: :get, class: "bw-period-custom", id: "dashboard-period-filter", local: true do %>
    <%= hidden_field_tag :preset, "custom" %>
    <div class="bw-field">
      <%= label_tag :start_date, t("billie.finance.ui.start_date") %>
      <%= date_field_tag :start_date, @filter_values[:start_date], required: true, aria: {invalid: (@date_filter_error ? "true" : nil), describedby: ("dashboard-period-error" if @date_filter_error)} %>
    </div>
    <div class="bw-field">
      <%= label_tag :end_date, t("billie.finance.ui.end_date") %>
      <%= date_field_tag :end_date, @filter_values[:end_date], required: true, aria: {invalid: (@date_filter_error ? "true" : nil), describedby: ("dashboard-period-error" if @date_filter_error)} %>
    </div>
    <%= submit_tag t("billie.finance.ui.apply_dates"), class: "bw-button bw-button-dark", name: nil %>
  <% end %>
  <% if @date_filter_error %>
    <p class="bw-period-error" id="dashboard-period-error" role="alert"><%= @date_filter_error %></p>
  <% end %>
</section>

<% unless @date_filter_error %>
<div class="bw-metrics">
  <article class="bw-metric" id="dashboard-income">
    <span><%= t("billie.finance.ui.total_income") %> <i class="bw-metric-symbol bw-positive"><%= finance_icon "down", size: 18 %></i></span>
    <strong><%= finance_money(@snapshot[:income], @profile.currency) %></strong>
    <small><%= @period.filtered? ? t("billie.finance.ui.in_the_selected_period") : t("billie.finance.ui.across_imported_statement_dates") %></small>
  </article>
  <article class="bw-metric" id="dashboard-expenses">
    <span><%= t("billie.finance.ui.total_expenses") %> <i class="bw-metric-symbol"><%= finance_icon "up", size: 18 %></i></span>
    <strong><%= finance_money(@snapshot[:expenses], @profile.currency) %></strong>
    <small><%= t("billie.finance.ui.transfers_and_excluded_items_omitted") %></small>
  </article>
  <article class="bw-metric" id="dashboard-net">
    <span><%= t("billie.finance.ui.net_cash_flow") %> <i class="bw-metric-symbol"><%= finance_icon "transactions", size: 18 %></i></span>
    <strong class="<%= 'bw-positive' if @snapshot[:net].to_d >= 0 %>"><%= finance_money(@snapshot[:net], @profile.currency) %></strong>
    <small><%= t("billie.finance.ui.income_minus_expenses") %></small>
  </article>
  <article class="bw-metric bw-metric-mint" id="dashboard-balance">
    <span><%= t("billie.finance.ui.cash_balance_from_statements") %> <i class="bw-metric-symbol"><%= finance_icon "wallet", size: 18 %></i></span>
    <strong><%= finance_balance_display(@profile) %></strong>
    <small><%= finance_balance_note(@profile) %></small>
    <% age_note = finance_balance_age_note(@profile) %>
    <% if age_note %><small class="bw-balance-age"><%= age_note %></small><% end %>
    <% if @balance_summary && @balance_summary[:credit_total].present? %><small class="bw-credit-owed"><%= t("billie.finance.ui.owed_on_credit_cards") %> <strong><%= finance_money(@balance_summary[:credit_total], @profile.currency) %></strong> (<%= finance_count(@balance_summary[:credit_count], "card") %>)</small><% end %>
    <%= link_to t("billie.finance.ui.view_account_balances"), finance_forecast_path(anchor: "account-balances"), class: "bw-metric-link" %>
    <%= link_to t("billie.finance.ui.enter_or_edit_balance"), finance_forecast_path(edit: "1", anchor: "balance"), class: "bw-metric-link" %>
  </article>
</div>

<%= render "finance/dashboard/accounts" %>

<% if !@has_transactions %>
  <section class="bw-welcome-card">
    <div class="bw-welcome-icon"><%= finance_icon "sun", size: 42 %></div>
    <div>
      <span class="bw-eyebrow"><%= t("billie.finance.ui.a_fresh_start") %></span>
      <h2><%= t("billie.finance.ui.your_financial_story_starts_here") %></h2>
      <p><%= t("billie.finance.ui.upload_your_first_csv_or_text_based_pdf_statement_to_see_income_spending_and_a_c") %></p>
      <%= link_to t("billie.finance.ui.upload_your_first_statement"), finance_statements_path, class: "bw-button bw-button-dark" %>
      <%= link_to t("billie.finance.ui.download_sample_csv"), sample_finance_statements_path(format: :csv), class: "bw-text-link" %>
    </div>
  </section>
<% elsif @snapshot[:transaction_count].zero? %>
  <section class="bw-panel bw-empty-state" id="dashboard-period-empty">
    <span class="bw-empty-icon"><%= finance_icon "transactions", size: 28 %></span>
    <h2><%= t("billie.finance.ui.no_transactions_in_this_period") %></h2>
    <p><%= t("billie.finance.ui.choose_different_dates_or_view_all_your_imported_transactions") %></p>
    <%= link_to t("billie.finance.ui.view_all_dates"), finance_dashboard_path(preset: "all_time"), class: "bw-button bw-button-outline" %>
  </section>
<% else %>
  <div class="bw-two-column">
    <section class="bw-panel">
      <div class="bw-panel-heading">
        <div>
          <h2><%= t("billie.finance.ui.money_in_money_out") %></h2>
          <p><%= @snapshot[:monthly].size > 6 ? t("billie.finance.ui.latest_6_months_with_transactions_in_this_period") : t("billie.finance.ui.monthly_totals_from_your_imported_transactions") %></p>
        </div>
        <div class="bw-legend"><span><i class="bw-legend-income"></i><%= t("billie.finance.ui.income") %></span><span><i class="bw-legend-expense"></i><%= t("billie.finance.ui.expenses") %></span></div>
      </div>
      <% monthly = @snapshot[:monthly].last(6); maximum = [monthly.flat_map { |month| [month[:income].to_f, month[:expenses].to_f] }.max.to_f, 1].max %>
      <div class="bw-bar-chart" role="img" aria-label="<%= t("billie.finance.ui.monthly_income_expenses") %>">
        <% monthly.each do |month| %>
          <div class="bw-bar-group">
            <div class="bw-bars">
              <div class="bw-bar bw-bar-income" style="height:<%= [(month[:income].to_f / maximum * 100).round(2), 1].max %>%" title="<%= t("billie.finance.ui.income_amount", amount: finance_money(month[:income], @profile.currency)) %>"></div>
              <div class="bw-bar bw-bar-expense" style="height:<%= [(month[:expenses].to_f / maximum * 100).round(2), 1].max %>%" title="<%= t("billie.finance.ui.expenses_amount", amount: finance_money(month[:expenses], @profile.currency)) %>"></div>
            </div>
            <span><%= finance_date(month[:month], "%b %Y") %></span>
          </div>
        <% end %>
      </div>
      <details class="bw-chart-details">
        <summary><%= t("billie.finance.ui.view_monthly_figures") %></summary>
        <% @snapshot[:monthly].each do |month| %>
          <p><%= finance_date(month[:month], "%b %Y") %><%= t("billie.finance.ui.income_2") %> <%= finance_money(month[:income], @profile.currency) %> <%= t("billie.finance.ui.expenses_2") %> <%= finance_money(month[:expenses], @profile.currency) %></p>
        <% end %>
      </details>
    </section>
    <section class="bw-panel">
      <div class="bw-panel-heading"><div><h2><%= t("billie.finance.ui.where_it_goes") %></h2><p><%= t("billie.finance.ui.your_expense_categories") %></p></div><%= finance_icon "transactions" %></div>
      <div class="bw-category-list">
        <% @snapshot[:categories].first(6).each_with_index do |category, index| %>
          <div>
            <div class="bw-category-row"><span><i class="bw-category-dot tone-<%= index % 4 %>"></i><%= finance_label(category[:name]) %></span><strong><%= finance_money(category[:amount], @profile.currency) %></strong></div>
            <div class="bw-category-track"><span class="tone-<%= index % 4 %>" style="width:<%= [(@snapshot[:expenses].to_f.positive? ? category[:amount].to_f / @snapshot[:expenses].to_f * 100 : 0).round(2), 100].min %>%"></span></div>
          </div>
        <% end %>
        <% if @snapshot[:categories].empty? %><p class="bw-muted"><%= t("billie.finance.ui.no_categorized_expenses_yet") %></p><% end %>
      </div>
    </section>
  </div>
<% end %>

<div class="bw-two-column bw-two-column-bottom">
  <section class="bw-panel bw-panel-flush">
    <div class="bw-panel-heading">
      <div><h2><%= t("billie.finance.ui.recent_transactions") %></h2><p><%= finance_count(@snapshot[:transaction_count], "transaction") %> <%= @period.filtered? ? t("billie.finance.ui.in_the_selected_period_2") : t("billie.finance.ui.in_your_financial_picture") %></p></div>
      <%= link_to t("billie.finance.ui.view_all"), finance_transactions_path(start_date: @period.start_date&.iso8601, end_date: @period.end_date&.iso8601), class: "bw-text-link" %>
    </div>
    <% if @recent_transactions.any? %>
      <%= render "finance/shared/transactions_table", transactions: @recent_transactions, currency: @profile.currency %>
    <% else %>
      <div class="bw-small-empty"><%= finance_icon "transactions", size: 28 %><p><%= @has_transactions ? t("billie.finance.ui.no_transactions_match_these_dates") : t("billie.finance.ui.your_latest_transactions_will_appear_here") %></p></div>
    <% end %>
  </section>
  <section class="bw-insight-promo">
    <span class="bw-feature-icon"><%= finance_icon "insights", size: 26 %></span>
    <span class="bw-eyebrow"><%= t("billie.finance.ui.a_fresh_perspective") %></span>
    <h2><%= t("billie.finance.ui.let_your_numbers") %><br><%= t("billie.finance.ui.tell_you_more") %></h2>
    <p><%= t("billie.finance.ui.explore_spending_observations_and_practical_next_steps_organize_transactions_tha") %></p>
    <% if @period.filtered? %><p><%= t("billie.finance.ui.insights_use_your_full_imported_history") %></p><% end %>
    <%= link_to finance_insights_path, class: "bw-button bw-button-dark" do %><%= t("billie.finance.ui.explore_insights") %> <%= finance_icon "arrow", size: 17 %><% end %>
    <% if @snapshot[:uncategorized_count].positive? %><small><%= finance_count(@snapshot[:uncategorized_count], "transaction") %> <%= t("billie.finance.ui.still_need_a_category") %></small><% end %>
  </section>
</div>
<% end %>

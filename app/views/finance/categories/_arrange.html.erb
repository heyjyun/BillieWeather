<% custom = !Finance::Transaction::CATEGORIES.include?(name) %>
<% kind = tree.kind_of(name) %>
<div class="bw-cat-manage" id="arrange">
  <%= form_with url: arrange_finance_categories_path, method: :patch, scope: :arrangement, data: {turbo: false}, class: "bw-form bw-form-grid" do |form| %>
    <%= hidden_field_tag :name, name, id: nil %>
    <% if custom %>
      <div class="bw-field"><%= form.label :category_kind, t("billie.ledger.categories.kind_label") %><%= form.select :category_kind, [[t("billie.ledger.categories.tree_expense"), "expense"], [t("billie.ledger.categories.tree_income"), "income"]], selected: kind %></div>
      <div class="bw-field"><%= form.label :parent_name, t("billie.ledger.categories.parent_label") %><%= form.select :parent_name, [[t("billie.ledger.categories.no_parent"), ""]] + tree.roots(kind).reject { |root| root.name == name }.map { |root| [finance_label(root.name), root.name] }, selected: tree.parent_of(name) %></div>
    <% end %>
    <div class="bw-field"><%= form.label :sort_order, t("billie.ledger.categories.order_label") %><%= form.number_field :sort_order, value: tree.roots(kind).flat_map { |r| [r, *r.children] }.find { |n| n.name == name }&.sort_order || 0, min: -999, max: 999 %></div>
    <label class="bw-checkbox-inline"><%= form.check_box :hidden, {checked: tree.hidden?(name)}, "1", "0" %><span><%= t("billie.ledger.categories.hide_label") %></span></label>
    <%= form.submit t("billie.ledger.categories.arrange"), class: "bw-button bw-button-outline" %>
  <% end %>
  <% if custom && (record = custom_record) %>
    <%= form_with url: finance_category_path(record), method: :delete, data: {turbo: false, confirm: t("billie.ledger.categories.merge_confirm", name: name)}, class: "bw-form bw-cat-add" do |form| %>
      <div class="bw-field"><%= label_tag "merge-#{record.id}", t("billie.ledger.categories.merge_label") %><%= select_tag :move_to, options_for_select(tree.names.reject { |n| n == name || n == "Transfers" }.map { |n| [finance_label(n), n] }), id: "merge-#{record.id}" %></div>
      <%= form.submit t("billie.ledger.categories.merge"), class: "bw-button bw-button-outline" %>
    <% end %>
  <% end %>
</div>

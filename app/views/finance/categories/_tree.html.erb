<%# The person's category tree, any depth. Top-level categories show; their subcategories open on
    request and the choice is remembered (finance_categories.expanded, saved by billie.js).
    Locals: tree (Finance::CategoryTree). %>
<section class="bw-panel bw-section-gap" id="category-tree" aria-labelledby="tree-heading">
  <div class="bw-panel-heading"><div><span class="bw-eyebrow"><%= t("billie.ledger.categories.tree_eyebrow") %></span><h2 id="tree-heading"><%= t("billie.ledger.categories.tree_title") %></h2><p><%= t("billie.ledger.categories.tree_body") %></p></div><%= finance_icon "tag" %></div>
  <ul class="bw-category-list bw-category-tree" data-tree="all">
    <% tree.roots.each_with_index do |root, index| %>
      <%= render "finance/categories/node", node: root, tree: tree, first: index.zero?, last: index == tree.roots.length - 1 %>
    <% end %>
  </ul>
</section>

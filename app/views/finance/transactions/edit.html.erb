<% content_for :title, t("billie.finance.ui.review_transaction") %>
<div class="bw-page-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.make_the_details_yours") %></span><h1><%= t("billie.finance.ui.review_transaction_2") %></h1><p><%= t("billie.finance.ui.keep_your_records_accurate_and_mark_anything_that_needs_a_closer_look") %></p></div><%= link_to t("billie.finance.ui.back_to_transactions"), finance_transactions_path, class: "bw-text-link" %></div>
<div class="bw-two-column"><section class="bw-panel"><div class="bw-transaction-summary"><span class="bw-transaction-icon"><%= finance_icon "transactions", size: 22 %></span><div><strong><%= @transaction.description %></strong><span><%= finance_date(@transaction.booked_on) %></span></div><strong class="bw-summary-amount <%= 'bw-positive' if @transaction.amount.positive? %>"><%= finance_money(@transaction.amount, @profile.currency) %></strong></div><% if @transaction.errors.any? %><div class="bw-flash bw-flash-error" role="alert"><%= @transaction.errors.full_messages.to_sentence %></div><% end %><%= form_with model: @transaction, url: finance_transaction_path(@transaction), method: :patch, scope: :finance_transaction, data: {turbo: false}, class: "bw-form" do |form| %><div class="bw-field"><%= form.label :description, t("billie.finance.ui.description") %><%= form.text_field :description, required: true, maxlength: 500 %></div><div class="bw-field"><%= form.label :category, t("billie.finance.ui.category") %><%= form.select :category, @categories.map { |category| [finance_label(category), category] } %><small><%= t("billie.finance.ui.auto_assigned_categories_are_a_starting_point_you_can_change_them_here") %></small></div><label class="bw-checkbox-card"><%= form.check_box :tax_review %><span><strong><%= t("billie.finance.ui.flag_for_tax_review") %></strong><small><%= t("billie.finance.ui.include_this_transaction_in_the_records_you_review_with_your_tax_professional") %></small></span></label><label class="bw-checkbox-card"><%= form.check_box :excluded %><span><strong><%= t("billie.finance.ui.exclude_from_totals_and_forecasts") %></strong><small><%= t("billie.finance.ui.use_for_duplicates_or_items_that_should_not_affect_your_financial_picture") %></small></span></label><div class="bw-form-footer"><%= link_to t("billie.finance.ui.cancel"), finance_transactions_path, class: "bw-text-link" %><%= form.submit t("billie.finance.ui.save_changes"), class: "bw-button bw-button-dark" %></div><% end %></section><aside class="bw-panel bw-panel-soft"><span class="bw-feature-icon"><%= finance_icon "file", size: 26 %></span><h2><%= t("billie.finance.ui.a_useful_record") %><br><%= t("billie.finance.ui.not_a_tax_decision") %></h2><p><%= t("billie.finance.ui.flagging_a_transaction_does_not_make_it_deductible_save_receipts_and_supporting") %></p><p class="bw-caption"><%= t("billie.finance.ui.the_original_date_and_amount_stay_tied_to_the_imported_statement_remove_and_re_i") %></p></aside></div>

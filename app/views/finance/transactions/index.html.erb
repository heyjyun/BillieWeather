<% content_for :title, t("billie.finance.ui.transactions") %>
<% if @date_filter_error %><div class="bw-flash bw-flash-error" role="alert"><%= @date_filter_error %></div><% end %>
<% if @date_range %><div class="bw-info-line"><p><%= t("billie.finance.ui.showing") %> <%= finance_date(@date_range.start_date) %> – <%= finance_date(@date_range.end_date) %>. <%= link_to t("billie.finance.ui.change_dates"), finance_dashboard_path(preset: "custom", start_date: @date_range.start_date.iso8601, end_date: @date_range.end_date.iso8601), class: "bw-text-link" %></p></div><% end %>
<div class="bw-page-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.the_everyday_details") %></span><h1><%= t("billie.finance.ui.every_transaction_has_a_story") %></h1><p><%= t("billie.finance.ui.review_your_spending_refine_categories_and_flag_records_for_tax_preparation") %></p></div><div class="bw-heading-actions"><%= link_to t("billie.finance.ui.export_csv"), finance_transactions_path(format: :csv, search: params[:search], category: params[:category], kind: params[:kind], start_date: params[:start_date], end_date: params[:end_date]), class: "bw-button bw-button-outline" %><%= link_to finance_statements_path, class: "bw-button bw-button-dark" do %><%= finance_icon "upload", size: 17 %> <%= t("billie.finance.ui.upload_statement") %><% end %></div></div>
<section class="bw-panel bw-panel-flush"><%= form_with url: finance_transactions_path, method: :get, data: {turbo: false}, class: "bw-filter-bar" do |form| %><% if params[:start_date].present? || params[:end_date].present? %><%= hidden_field_tag :start_date, params[:start_date] %><%= hidden_field_tag :end_date, params[:end_date] %><% end %><div class="bw-search-field"><%= finance_icon "search", size: 18 %><%= form.label :search, t("billie.finance.ui.search_transactions"), class: "bw-sr-only" %><%= form.search_field :search, value: params[:search], placeholder: t("billie.finance.ui.search_transactions_2") %></div><div><%= form.label :category, t("billie.finance.ui.category"), class: "bw-sr-only" %><%= form.select :category, options_for_select([[t("billie.finance.ui.all_categories"), ""]] + @categories.map { |category| [finance_label(category), category] }, params[:category]) %></div><div><%= form.label :kind, t("billie.finance.ui.transaction_type"), class: "bw-sr-only" %><%= form.select :kind, options_for_select([[t("billie.finance.ui.all_transactions"), ""], [t("billie.finance.ui.income"), "income"], [t("billie.finance.ui.expenses"), "expense"], [t("billie.finance.ui.tax_review_2"), "review"], [t("billie.finance.ui.excluded_2"), "excluded"]], params[:kind]) %></div><%= form.submit t("billie.finance.ui.apply_filters"), class: "bw-button bw-button-dark" %><%= link_to t("billie.finance.ui.reset"), finance_transactions_path, class: "bw-text-link" if params.values_at(:search, :category, :kind, :start_date, :end_date).any?(&:present?) %><% end %><div class="bw-results-heading"><span><strong><%= number_with_delimiter(@total_count) %></strong> <%= t("billie.finance.ui.transactions_found", count: @total_count) %></span><span><%= t("billie.finance.ui.amounts_in") %> <%= @profile.currency %></span></div><% if @transactions.any? %><%= render "finance/shared/transactions_table", transactions: @transactions, currency: @profile.currency %><% else %><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "transactions", size: 32 %></span><h3><%= params.values_at(:search, :category, :kind, :start_date, :end_date).any?(&:present?) ? t("billie.finance.ui.no_matching_transactions") : t("billie.finance.ui.your_transactions_belong_here") %></h3><p><%= params.values_at(:search, :category, :kind, :start_date, :end_date).any?(&:present?) ? t("billie.finance.ui.try_another_search_or_clear_your_filters") : t("billie.finance.ui.import_a_statement_to_see_your_income_and_expenses_in_one_place") %></p><%= link_to t("billie.finance.ui.upload_a_statement"), finance_statements_path, class: "bw-button bw-button-dark" if @total_count.zero? && params.values_at(:search, :category, :kind, :start_date, :end_date).none?(&:present?) %></div><% end %><% if defined?(@page) && defined?(@total_pages) && @total_pages.to_i > 1 %><div class="bw-pagination"><%= link_to t("billie.finance.ui.previous"), finance_transactions_path(request.query_parameters.merge(page: @page - 1)), class: "bw-button bw-button-outline" if @page > 1 %><span><%= t("billie.finance.ui.page_of_total", page: @page, total: @total_pages) %></span><%= link_to t("billie.finance.ui.next"), finance_transactions_path(request.query_parameters.merge(page: @page + 1)), class: "bw-button bw-button-outline" if @page < @total_pages %></div><% end %></section>
<div class="bw-info-line"><%= finance_icon "file", size: 18 %><p><%= t("billie.finance.ui.categories_help_organize_records_they_do_not_determine_tax_deductibility_transfe") %></p></div>

<% content_for :title, t("billie.finance.ui.transactions") %>
<% if @date_filter_error %><div class="bw-flash bw-flash-error" role="alert"><%= @date_filter_error %></div><% end %>
<% if @date_range %><div class="bw-info-line"><p><%= t("billie.finance.ui.showing") %> <%= finance_date(@date_range.start_date) %> – <%= finance_date(@date_range.end_date) %>. <%= link_to t("billie.finance.ui.change_dates"), finance_dashboard_path(preset: "custom", start_date: @date_range.start_date.iso8601, end_date: @date_range.end_date.iso8601), class: "bw-text-link" %></p></div><% end %>
<div class="bw-page-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.the_everyday_details") %></span><h1><%= t("billie.finance.ui.every_transaction_has_a_story") %></h1><p><%= t("billie.finance.ui.review_your_spending_refine_categories_and_flag_records_for_tax_preparation") %></p></div><div class="bw-heading-actions"><% unless manual_mode? %><%= link_to t("billie.ledger.manual.title"), finance_transactions_path(request.query_parameters.merge(tools: (@manual_tools ? nil : "manual"))), class: "bw-button bw-button-outline", "aria-expanded": @manual_tools %><% end %><%= link_to t("billie.finance.ui.export_csv"), finance_transactions_path(@filters.merge(format: :csv)), class: "bw-button bw-button-outline" %><%= link_to finance_statements_path, class: "bw-button #{@manual_tools ? 'bw-button-outline' : 'bw-button-dark'}" do %><%= finance_icon "upload", size: 17 %> <%= t("billie.finance.ui.upload_statement") %><% end %><% if @manual_tools %><%= link_to new_finance_entry_path, class: "bw-button bw-button-dark", id: "add-entry" do %><%= finance_icon "transactions", size: 17 %> <%= t("billie.ledger.entries.add") %><% end %><% end %></div></div>
<% if @manual_tools %><div class="bw-inline-actions" id="ledger-links"><%= link_to t("billie.ledger.review.income_link", count: @review_counts[:income]), finance_review_income_path, class: "bw-text-link" if @review_counts[:income].positive? %><%= link_to t("billie.ledger.review.duplicates_link", count: @review_counts[:duplicates]), finance_review_duplicates_path, class: "bw-text-link" if @review_counts[:duplicates].positive? %><%= link_to t("billie.ledger.trash.link", count: @review_counts[:trash]), finance_trash_path, class: "bw-text-link" %><%= link_to t("billie.ledger.activity.title"), finance_activity_path, class: "bw-text-link" %><%= link_to t("billie.ledger.recurring.title"), finance_recurring_rules_path, class: "bw-text-link" %></div><% end %>
<section class="bw-panel bw-panel-flush"><%= form_with url: finance_transactions_path, method: :get, data: {turbo: false}, class: "bw-filter-bar" do |form| %><%= hidden_field_tag :activity, @filters["activity"] if @filters["activity"].present? %><%= hidden_field_tag :currency, @filters["currency"] if @filters["currency"].present? %><%= hidden_field_tag :account_id, @filters["account_id"] if !@manual_tools && @filters["account_id"].present? %><%= hidden_field_tag :tools, "manual" if params[:tools] == "manual" %><% if params[:start_date].present? || params[:end_date].present? %><%= hidden_field_tag :start_date, params[:start_date] %><%= hidden_field_tag :end_date, params[:end_date] %><% end %><div class="bw-search-field"><%= finance_icon "search", size: 18 %><%= form.label :search, t("billie.finance.ui.search_transactions"), class: "bw-sr-only" %><%= form.search_field :search, value: params[:search], placeholder: t("billie.finance.ui.search_transactions_2") %></div><div><%= form.label :category, t("billie.finance.ui.category"), class: "bw-sr-only" %><%= form.select :category, options_for_select([[t("billie.finance.ui.all_categories"), ""]] + @category_tree.options(include_hidden: true, label: method(:finance_label)), params[:category]) %></div><div><%= form.label :kind, t("billie.finance.ui.transaction_type"), class: "bw-sr-only" %><%= form.select :kind, options_for_select([[t("billie.finance.ui.all_transactions"), ""], [t("billie.finance.ui.income"), "income"], [t("billie.finance.ui.expenses"), "expense"]] + (@manual_tools ? %w[refund transfer card_payment adjustment].map { |k| [t("billie.ledger.kinds.#{k}"), k] } + [[t("billie.ledger.entries.manual_only"), "manual"]] : []) + [[t("billie.finance.ui.tax_review_2"), "review"], [t("billie.finance.ui.excluded_2"), "excluded"]], params[:kind]) %></div><% if @manual_tools %><% if @accounts.any? %><div><%= form.label :account_id, t("billie.ledger.fields.account"), class: "bw-sr-only" %><%= form.select :account_id, options_for_select([[t("billie.ledger.filters.all_accounts"), ""]] + @accounts.map { |a| [a.display_name, a.id] }, params[:account_id]) %></div><% end %><% if @merchants.any? %><div><%= form.label :merchant_id, t("billie.ledger.fields.merchant"), class: "bw-sr-only" %><%= form.select :merchant_id, options_for_select([[t("billie.ledger.filters.all_merchants"), ""]] + @merchants.map { |m| [m.name, m.id] }, params[:merchant_id]) %></div><% end %><% if @projects.any? %><div><%= form.label :project_id, t("billie.ledger.fields.project"), class: "bw-sr-only" %><%= form.select :project_id, options_for_select([[t("billie.ledger.filters.all_projects"), ""]] + @projects.map { |p| [p.name, p.id] }, params[:project_id]) %></div><% end %><% if @tags.any? %><div><%= form.label :tag_id, t("billie.ledger.fields.tags"), class: "bw-sr-only" %><%= form.select :tag_id, options_for_select([[t("billie.ledger.filters.all_tags"), ""]] + @tags.map { |tag| [tag.name, tag.id] }, params[:tag_id]) %></div><% end %><% end %><%= form.submit t("billie.finance.ui.apply_filters"), class: "bw-button bw-button-dark" %><%= link_to t("billie.finance.ui.reset"), finance_transactions_path, class: "bw-text-link" if @filters.values.any?(&:present?) %><% end %><div class="bw-results-heading"><span><strong><%= number_with_delimiter(@total_count) %></strong> <%= t("billie.finance.ui.transactions_found", count: @total_count) %></span><span><%= t("billie.finance.ui.amounts_in") %> <%= @filters["currency"].presence || @profile.currency %></span></div><% if @transactions.any? %><% if @manual_tools %><%= form_with url: batch_finance_transactions_path, id: "batch-form", data: {turbo: false}, class: "bw-filter-bar" do |form| %><span><strong><%= t("billie.ledger.batch.title") %></strong></span><div><%= form.label :batch_action, t("billie.ledger.batch.action"), class: "bw-sr-only" %><%= form.select :batch_action, [[t("billie.ledger.batch.actions.category"), "category"], [t("billie.ledger.batch.actions.project"), "project"], [t("billie.ledger.batch.actions.merchant"), "merchant"], [t("billie.ledger.batch.actions.tag"), "tag"], [t("billie.ledger.batch.actions.delete"), "delete"]] %></div><div><%= form.label :value, t("billie.ledger.batch.value"), class: "bw-sr-only" %><%= form.select :value, grouped_options_for_select({t("billie.ledger.batch.actions.category") => @category_tree.options(label: method(:finance_label)), t("billie.ledger.batch.actions.project") => @projects.map { |p| [p.name, p.id] }, t("billie.ledger.batch.actions.merchant") => @merchants.map { |m| [m.name, m.id] }, t("billie.ledger.batch.actions.tag") => @tags.map { |tag| [tag.name, tag.id] }}), include_blank: t("billie.ledger.fields.none") %></div><%= form.submit t("billie.ledger.batch.apply"), class: "bw-button bw-button-outline", data: {confirm: t("billie.ledger.batch.confirm")} %><% end %><% end %><%= render "finance/shared/transactions_table", transactions: @transactions, currency: @filters["currency"].presence || @profile.currency, selectable: @manual_tools %><% else %><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "transactions", size: 32 %></span><h3><%= @filters.values.any?(&:present?) ? t("billie.finance.ui.no_matching_transactions") : t("billie.finance.ui.your_transactions_belong_here") %></h3><p><%= @filters.values.any?(&:present?) ? t("billie.finance.ui.try_another_search_or_clear_your_filters") : t("billie.finance.ui.import_a_statement_to_see_your_income_and_expenses_in_one_place") %></p><%= link_to t("billie.finance.ui.upload_a_statement"), finance_statements_path, class: "bw-button bw-button-dark" if @total_count.zero? && @filters.values.none?(&:present?) %></div><% end %><% if defined?(@page) && defined?(@total_pages) && @total_pages.to_i > 1 %><div class="bw-pagination"><%= link_to t("billie.finance.ui.previous"), finance_transactions_path(request.query_parameters.merge(page: @page - 1)), class: "bw-button bw-button-outline" if @page > 1 %><span><%= t("billie.finance.ui.page_of_total", page: @page, total: @total_pages) %></span><%= link_to t("billie.finance.ui.next"), finance_transactions_path(request.query_parameters.merge(page: @page + 1)), class: "bw-button bw-button-outline" if @page < @total_pages %></div><% end %></section>
<div class="bw-info-line"><%= finance_icon "file", size: 18 %><p><%= t("billie.finance.ui.categories_help_organize_records_they_do_not_determine_tax_deductibility_transfe") %></p></div>

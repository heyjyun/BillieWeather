<% content_for :title, "Transactions" %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">THE EVERYDAY DETAILS</span><h1>Every transaction has a story.</h1><p>Review your spending, refine categories, and flag records for tax preparation.</p></div><div class="bw-heading-actions"><%= link_to "Export CSV", finance_transactions_path(format: :csv, search: params[:search], category: params[:category], kind: params[:kind]), class: "bw-button bw-button-outline" %><%= link_to finance_statements_path, class: "bw-button bw-button-dark" do %><%= finance_icon "upload", size: 17 %> Import statement<% end %></div></div>
<section class="bw-panel bw-panel-flush"><%= form_with url: finance_transactions_path, method: :get, data: {turbo: false}, class: "bw-filter-bar" do |form| %><div class="bw-search-field"><%= finance_icon "search", size: 18 %><%= form.label :search, "Search transactions", class: "bw-sr-only" %><%= form.search_field :search, value: params[:search], placeholder: "Search transactions…" %></div><div><%= form.label :category, "Category", class: "bw-sr-only" %><%= form.select :category, options_for_select([["All categories", ""]] + @categories.map { |category| [category, category] }, params[:category]) %></div><div><%= form.label :kind, "Transaction type", class: "bw-sr-only" %><%= form.select :kind, options_for_select([["All transactions", ""], ["Income", "income"], ["Expenses", "expense"], ["Tax review", "review"], ["Excluded", "excluded"]], params[:kind]) %></div><%= form.submit "Apply filters", class: "bw-button bw-button-dark" %><%= link_to "Reset", finance_transactions_path, class: "bw-text-link" if params.values_at(:search, :category, :kind).any?(&:present?) %><% end %><div class="bw-results-heading"><span><strong><%= number_with_delimiter(@total_count) %></strong> <%= "transaction".pluralize(@total_count) %> found</span><span>Amounts in <%= @profile.currency %></span></div><% if @transactions.any? %><%= render "finance/shared/transactions_table", transactions: @transactions, currency: @profile.currency %><% else %><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "transactions", size: 32 %></span><h3><%= params.values_at(:search, :category, :kind).any?(&:present?) ? "No matching transactions." : "Your transactions belong here." %></h3><p><%= params.values_at(:search, :category, :kind).any?(&:present?) ? "Try another search or clear your filters." : "Import a statement to see your income and expenses in one place." %></p><%= link_to "Upload a statement", finance_statements_path, class: "bw-button bw-button-dark" if @total_count.zero? && params.values_at(:search, :category, :kind).none?(&:present?) %></div><% end %><% if defined?(@page) && defined?(@total_pages) && @total_pages.to_i > 1 %><div class="bw-pagination"><%= link_to "← Previous", finance_transactions_path(request.query_parameters.merge(page: @page - 1)), class: "bw-button bw-button-outline" if @page > 1 %><span>Page <%= @page %> of <%= @total_pages %></span><%= link_to "Next →", finance_transactions_path(request.query_parameters.merge(page: @page + 1)), class: "bw-button bw-button-outline" if @page < @total_pages %></div><% end %></section>
<div class="bw-info-line"><%= finance_icon "file", size: 18 %><p>Categories help organize records; they do not determine tax deductibility. Transfers and excluded transactions are omitted from income and expense totals.</p></div>

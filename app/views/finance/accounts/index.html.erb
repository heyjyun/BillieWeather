<% content_for :title, t("billie.ledger.accounts.title") %>
<%# Accounts & Assets: the shared grouped table (clients/universal/src/accounts), mounted by /accounts-table.js.
    The plain table below is what people without JavaScript see, and what the script replaces. %>
<div class="bw-page-heading bw-page-heading-compact">
  <div><h1><%= t("billie.ledger.accounts.title") %></h1><p><%= t("billie.ledger.accounts.intro") %></p></div>
  <div class="bw-heading-actions">
    <%= link_to t("billie.ledger.entries.add"), new_finance_entry_path, class: "bw-button bw-button-outline bw-button-small" %>
  </div>
</div>

<div id="accounts-capture">
  <%= render "capture" %>
  <% if @last_capture %>
    <%= button_to assistant_copy["undoCapture"], finance_undo_account_capture_path, params: {key: @last_capture}, class: "bw-link-button" %>
  <% end %>
</div>

<% rows = @table.rows %>
<% table = {
  context: {locale: I18n.locale.to_s, primary: @profile.currency, today: finance_today.iso8601,
    typeNames: Finance::BankAccount::TYPES.index_with { |type| t("billie.ledger.account_types.#{type}") }, typeOrder: Finance::BankAccount::TYPES,
    storageKey: "billie.accounts.table.v1:web:#{current_user.finance_owner_uid || current_user.id}"},
  rows: rows, positions: @table.positions, addLabel: t("billie.ledger.accounts.new"),
  links: {edit: edit_finance_account_path("__ID__"), transactions: finance_transactions_path(account_id: "__ID__"), entry: new_finance_entry_path(account_id: "__ID__"),
    adjust: edit_finance_account_path("__ID__", anchor: "adjust-balance"), statements: finance_statements_path, archive: archive_finance_account_path("__ID__"),
    unarchive: unarchive_finance_account_path("__ID__"), destroy: finance_account_path("__ID__"), reorder: reorder_finance_accounts_path, manual: new_finance_account_path}
} %>
<%= tag.div id: "accounts-table", class: "at-host", data: {table: table.to_json} do %>
  <% main = @table.positions.find { |p| p[:currency] == @profile.currency } %>
  <% known = ->(holdings) { holdings.reject { |h| h[:balance].nil? } } %>
  <% included = main ? known.call(main[:position][:holdings]).select { |h| h[:included] } : [] %>
  <% money = ->(cents) { finance_money(BigDecimal(cents) / 100, @profile.currency) } %>
  <div class="bw-metrics bw-metrics-three" id="net-worth">
    <div class="bw-metric"><span><%= t("billie.ledger.accounts.assets") %></span><strong><%= money.call(included.reject { |h| h[:liability] }.sum { |h| h[:balance] }) %></strong></div>
    <div class="bw-metric"><span><%= t("billie.ledger.accounts.liabilities") %></span><strong><%= money.call(-included.select { |h| h[:liability] }.sum { |h| h[:balance] }) %></strong></div>
    <div class="bw-metric"><span><%= t("billie.ledger.accounts.net_worth") %></span><strong><%= money.call(included.sum { |h| h[:balance] }) %></strong></div>
  </div>
  <% if rows.any? %>
    <div class="bw-table-scroll"><table class="bw-table">
      <thead><tr><th scope="col"><%= t("billie.ledger.accounts.col_account") %></th><th scope="col"><%= t("billie.ledger.accounts.type") %></th><th scope="col" class="bw-text-right"><%= t("billie.ledger.accounts.col_balance") %></th></tr></thead>
      <tbody>
        <% rows.reject { |r| r[:archived] }.each do |row| %>
          <tr id="account-<%= row[:id] %>">
            <td><%= link_to row[:name], edit_finance_account_path(row[:id]), class: "bw-table-link" %> <small class="bw-muted"><%= [row[:institution], (row[:last4] && "•••• #{row[:last4]}")].compact.join(" · ") %></small></td>
            <td><%= t("billie.ledger.account_types.#{row[:type]}") %></td>
            <td class="bw-text-right bw-nowrap"><%= row[:balance].nil? ? "—" : "#{row[:currency]} #{number_with_precision(BigDecimal(row[:liability] ? -row[:balance] : row[:balance]) / 100, precision: 2, delimiter: ",")}" %></td>
          </tr>
        <% end %>
      </tbody>
    </table></div>
  <% end %>
<% end %>
<script src="/accounts-table.js" defer></script>

<details class="bw-panel bw-section-gap" id="statement-account-details" <%= "open" if params[:statement_details] == "1" %>>
  <summary class="bw-text-link"><%= t("billie.finance.ui.cash_accounts") %> · <%= t("billie.finance.ui.cash_on_hand") %></summary>
  <%= render "finance/dashboard/accounts" %>
</details>

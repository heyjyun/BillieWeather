<% content_for :title, "Billie Insights" %>
<% ai_service_name = Finance::InsightGenerator.ai_service_name %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">TURN INFORMATION INTO NEXT STEPS</span><h1>A fresh perspective on your finances.</h1><p>Understand patterns, consider practical actions, and get your records ready for tax season.</p></div><span class="bw-pill"><%= finance_icon "insights", size: 16 %> Your numbers, thoughtfully explained</span></div>
<div class="bw-insights-intro"><div><span class="bw-feature-icon"><%= finance_icon "insights", size: 28 %></span><h2>Clarity starts with context.</h2><p>Basic analysis uses your totals and categories. Optional Billie Insights send an aggregate financial summary to <%= ai_service_name %>; it does not send your original statements, transaction descriptions, or account email.</p></div><div class="bw-insight-controls"><%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form" do |form| %><%= form.hidden_field :provider, value: "rules", id: nil %><%= form.submit "Generate basic analysis", class: "bw-button bw-button-dark bw-full-width", disabled: @snapshot[:transaction_count].zero? %><% end %><% if @ai_available %><%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form bw-ai-form" do |form| %><%= form.hidden_field :provider, value: "openai", id: nil %><label class="bw-checkbox-inline"><%= form.check_box :consent, {required: true}, "1", "0" %><span>I agree to send the displayed aggregate summary and tax context to <%= ai_service_name %> for this analysis.</span></label><%= form.submit "Generate Billie Insights", class: "bw-button bw-button-outline bw-full-width", disabled: @snapshot[:transaction_count].zero? %><% end %><% else %><p class="bw-caption bw-ai-unavailable">Billie is not connected yet. Basic analysis is available without an AI service.</p><% end %><% if @snapshot[:transaction_count].zero? %><p class="bw-caption">Import a statement first to generate an analysis.</p><% end %></div></div>
<section class="bw-summary-preview bw-section-gap"><div><strong>Summary used for analysis</strong><span><%= finance_period(@snapshot) %></span></div><dl><div><dt>Income</dt><dd><%= finance_money(@snapshot[:income], @profile.currency) %></dd></div><div><dt>Expenses</dt><dd><%= finance_money(@snapshot[:expenses], @profile.currency) %></dd></div><div><dt>Net cash flow</dt><dd><%= finance_money(@snapshot[:net], @profile.currency) %></dd></div><div><dt>Transactions</dt><dd><%= @snapshot[:transaction_count] %></dd></div></dl><details><summary>Categories and context</summary><p>Tax jurisdiction: <%= @profile.tax_country.presence || "Not specified" %> · Context: <%= @profile.tax_profile.presence&.humanize || "Not specified" %></p><% @snapshot[:categories].each do |category| %><p><%= category[:name] %>: <%= finance_money(category[:amount], @profile.currency) %></p><% end %><p>Uncategorized: <%= @snapshot[:uncategorized_count] %> · Tax review: <%= @snapshot[:tax_review_count] %> · Excluded: <%= @snapshot[:excluded_count] %> · Transfers: <%= @snapshot[:transfer_count] %></p><div class="bw-table-scroll"><table class="bw-table"><caption class="bw-sr-only">Monthly aggregate totals included in analysis</caption><thead><tr><th scope="col">Month</th><th scope="col">Income</th><th scope="col">Expenses</th><th scope="col">Net</th></tr></thead><tbody><% @snapshot[:monthly].last(12).each do |month| %><tr><td><%= finance_date(month[:month], "%b %Y") %></td><td><%= finance_money(month[:income], @profile.currency) %></td><td><%= finance_money(month[:expenses], @profile.currency) %></td><td><%= finance_money(month[:net], @profile.currency) %></td></tr><% end %></tbody></table></div></details></section>
<% if @insight.present? && @insight_stale %><div class="bw-stale-notice" role="status">Your records or profile changed since this analysis was generated. Generate a new analysis to reflect the latest information.</div><% end %>
<% if @insight.present? %>
  <% content = @insight.content.with_indifferent_access %>
  <section class="bw-panel bw-section-gap"><div class="bw-panel-heading"><div><h2>Your financial outlook</h2><p>Generated <%= finance_date(@insight.generated_at) %> · <%= @insight.source == "openai" ? "Billie Insights" : "Basic analysis · rules-based" %></p></div><span class="bw-badge"><%= @insight.source == "openai" ? "Billie Insights" : "Basic analysis" %></span></div><p class="bw-insight-summary"><%= content[:summary] %></p></section>
  <div class="bw-two-column bw-section-gap"><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow">WHAT YOUR NUMBERS SAY</span><h2>Financial observations</h2></div><%= finance_icon "forecast" %></div><div class="bw-insight-list"><% Array(content[:observations]).each do |item| %><article><span class="bw-insight-bullet"><%= finance_icon "transactions", size: 17 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div></section><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow">SMALL STEPS, CLEARER DIRECTION</span><h2>Actions to consider</h2></div><%= finance_icon "check" %></div><div class="bw-insight-list"><% Array(content[:actions]).each_with_index do |item, index| %><article><span class="bw-action-number"><%= format("%02d", index + 1) %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div></section></div>
<% else %>
  <section class="bw-panel bw-section-gap"><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "insights", size: 32 %></span><h3>Your next insight is in your numbers.</h3><p><%= @snapshot[:transaction_count].zero? ? "Upload a statement, review your categories, then generate your first analysis." : "Generate an analysis to see observations and actions based on your imported transactions." %></p></div></section>
<% end %>
<% if @tax_insight.present? && @tax_insight_stale %><div class="bw-stale-notice" role="status">Your records or profile changed since Billie prepared these tax insights. Ask Billie again to reflect the latest information.</div><% end %>
<section class="bw-panel bw-section-gap" id="billie-tax-insights">
  <div class="bw-panel-heading">
    <div>
      <span class="bw-eyebrow">BILLIE INSIGHTS</span>
      <h2>Tax preparation</h2>
      <p>Billie reviews your financial summary and your saved tax context to help you organize records and prepare questions for a tax professional.</p>
    </div>
    <%= finance_icon "insights" %>
  </div>
  <% if @tax_insight.present? %>
    <% tax_content = @tax_insight.content.with_indifferent_access %>
    <p class="bw-caption">Generated <%= finance_date(@tax_insight.generated_at) %> · Billie Insights</p>
    <p class="bw-insight-summary"><%= tax_content[:summary] %></p>
    <div class="bw-two-column bw-section-gap">
      <div>
        <h3>Records to organize</h3>
        <div class="bw-insight-list">
          <% Array(tax_content[:tax_preparation]).each do |item| %>
            <article><span class="bw-check-outline"><%= finance_icon "check", size: 16 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article>
          <% end %>
        </div>
      </div>
      <div>
        <h3>Questions for your tax professional</h3>
        <div class="bw-insight-list">
          <% Array(tax_content[:questions]).each_with_index do |item, index| %>
            <article><span class="bw-action-number"><%= format("%02d", index + 1) %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article>
          <% end %>
        </div>
      </div>
    </div>
    <% if Array(tax_content[:limitations]).any? %><div class="bw-analysis-limitations"><strong>Keep this in perspective</strong><ul><% Array(tax_content[:limitations]).each do |limitation| %><li><%= limitation %></li><% end %></ul></div><% end %>
  <% end %>
  <% if @ai_available %>
    <%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form bw-ai-form" do |form| %>
      <%= form.hidden_field :kind, value: "tax", id: nil %>
      <label class="bw-checkbox-inline"><%= form.check_box :consent, {required: true, id: "tax_consent"}, "1", "0" %><span>I agree to send the displayed aggregate summary and tax context to <%= ai_service_name %> for this analysis.</span></label>
      <%= form.submit (@tax_insight.present? ? "Ask Billie again" : "Ask Billie for tax preparation insights"), class: "bw-button bw-button-outline", disabled: @snapshot[:transaction_count].zero? %>
    <% end %>
    <% if @snapshot[:transaction_count].zero? %><p class="bw-caption">Import a statement first so Billie has something to review.</p><% end %>
  <% else %>
    <p class="bw-caption bw-ai-unavailable">Billie is not connected yet. The checklist below is available without an AI service.</p>
  <% end %>
</section>
<div class="bw-two-column bw-section-gap"><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow">U.S. PERSONAL TAX PREPARATION</span><h2>Get your tax records ready</h2><p>Bank deposits are not automatically taxable income. This is a preparation checklist, not a completed tax return.</p></div><%= finance_icon "file" %></div><% tax_items = @insight.present? ? Array(@insight.content.with_indifferent_access[:tax_preparation]) : [{title: "Review your transaction categories", body: "Check uncategorized transactions, transfers, and any business-related items."}, {title: "Gather U.S. personal tax documents", body: "Collect applicable W-2 and 1099 forms, mortgage or student-loan interest statements, health coverage records, receipts, and your prior-year return."}, {title: "Review federal and state requirements", body: "Match records to official tax documents and review your individual circumstances with a qualified tax professional."}] %><div class="bw-insight-list"><% tax_items.each do |item| %><article><span class="bw-check-outline"><%= finance_icon "check", size: 16 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div><p class="bw-caption"><%= link_to "IRS: gather your documents →", "https://www.irs.gov/filing/gather-your-documents", class: "bw-text-link", target: "_blank", rel: "noopener noreferrer" %></p><div class="bw-inline-actions"><%= link_to "Review flagged transactions →", finance_transactions_path(kind: "review"), class: "bw-text-link" %><%= link_to "Export records", finance_transactions_path(format: :csv), class: "bw-button bw-button-outline" %></div></section><section class="bw-panel bw-panel-soft"><div class="bw-panel-heading"><div><h2>Your tax context</h2><p>Preparation guidance depends on your circumstances.</p></div><%= finance_icon "settings" %></div><%= form_with model: @profile, scope: :finance_profile, url: finance_profile_path, method: :patch, data: {turbo: false}, class: "bw-form" do |form| %><%= hidden_field_tag :return_to, "insights" %><div class="bw-field"><%= form.label :tax_country, "Tax country or jurisdiction" %><%= form.text_field :tax_country, placeholder: "United States", maxlength: 100 %></div><div class="bw-field"><%= form.label :tax_profile, "Financial context" %><%= form.select :tax_profile, [["Not specified", ""], ["Personal", "personal"], ["Self-employed", "self_employed"], ["Small business", "business"]] %></div><%= form.submit "Save tax context", class: "bw-button bw-button-outline" %><% end %><p class="bw-caption">This information adds context to the next analysis. BillieWeather does not calculate tax liability or file tax returns.</p></section></div>
<% if @insight.present? && Array(@insight.content.with_indifferent_access[:limitations]).any? %><div class="bw-analysis-limitations"><strong>Keep this analysis in perspective</strong><ul><% Array(@insight.content.with_indifferent_access[:limitations]).each do |limitation| %><li><%= limitation %></li><% end %></ul></div><% end %>
<div class="bw-info-line"><%= finance_icon "file", size: 18 %><p>Analysis can be incomplete or incorrect. It is for financial organization and general education, not individualized investment, legal, or tax advice. Verify important decisions and current tax rules with an appropriate professional.</p></div>

<% content_for :title, t("billie.finance.ui.billie_insights") %>
<% ai_service_name = Finance::InsightGenerator.ai_service_name %>
<div class="bw-page-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.turn_information_into_next_steps") %></span><h1><%= t("billie.finance.ui.a_fresh_perspective_on_your_finances") %></h1><p><%= t("billie.finance.ui.understand_patterns_consider_practical_actions_and_get_your_records_ready_for_ta") %></p></div><span class="bw-pill"><%= finance_icon "insights", size: 16 %> <%= t("billie.finance.ui.your_numbers_thoughtfully_explained") %></span></div>
<div class="bw-insights-intro"><div><span class="bw-feature-icon"><%= finance_icon "insights", size: 28 %></span><h2><%= t("billie.finance.ui.clarity_starts_with_context") %></h2><p><%= t("billie.finance.ui.analysis_privacy", service: ai_service_name) %></p></div><div class="bw-insight-controls"><%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form" do |form| %><%= form.hidden_field :provider, value: "rules", id: nil %><%= form.submit t("billie.finance.ui.generate_basic_analysis"), class: "bw-button bw-button-dark bw-full-width", disabled: @snapshot[:transaction_count].zero? %><% end %><% if @ai_available %><%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form bw-ai-form" do |form| %><%= form.hidden_field :provider, value: "openai", id: nil %><label class="bw-checkbox-inline"><%= form.check_box :consent, {required: true}, "1", "0" %><span><%= t("billie.finance.ui.analysis_consent", service: ai_service_name) %></span></label><%= form.submit t("billie.finance.ui.generate_billie_insights"), class: "bw-button bw-button-outline bw-full-width", disabled: @snapshot[:transaction_count].zero? %><% end %><% else %><p class="bw-caption bw-ai-unavailable"><%= t("billie.finance.ui.billie_is_not_connected_yet_basic_analysis_is_available_without_an_ai_service") %></p><% end %><% if @snapshot[:transaction_count].zero? %><p class="bw-caption"><%= t("billie.finance.ui.import_a_statement_first_to_generate_an_analysis") %></p><% end %></div></div>
<section class="bw-summary-preview bw-section-gap"><div><strong><%= t("billie.finance.ui.summary_used_for_analysis") %></strong><span><%= finance_period(@snapshot) %></span></div><dl><div><dt><%= t("billie.finance.ui.income") %></dt><dd><%= finance_money(@snapshot[:income], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.expenses") %></dt><dd><%= finance_money(@snapshot[:expenses], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.net_cash_flow") %></dt><dd><%= finance_money(@snapshot[:net], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.transactions") %></dt><dd><%= @snapshot[:transaction_count] %></dd></div></dl><details><summary><%= t("billie.finance.ui.categories_and_context") %></summary><p><%= t("billie.finance.ui.tax_jurisdiction") %> <%= @profile.tax_country.presence || t("billie.finance.ui.not_specified") %> <%= t("billie.finance.ui.context") %> <%= (@profile.tax_profile.present? ? finance_label(@profile.tax_profile.humanize) : nil) || t("billie.finance.ui.not_specified") %></p><% @snapshot[:categories].each do |category| %><p><%= finance_label(category[:name]) %>: <%= finance_money(category[:amount], @profile.currency) %></p><% end %><p><%= t("billie.finance.ui.uncategorized") %> <%= @snapshot[:uncategorized_count] %> <%= t("billie.finance.ui.tax_review") %> <%= @snapshot[:tax_review_count] %> <%= t("billie.finance.ui.excluded") %> <%= @snapshot[:excluded_count] %> <%= t("billie.finance.ui.transfers") %> <%= @snapshot[:transfer_count] %></p><div class="bw-table-scroll"><table class="bw-table"><caption class="bw-sr-only"><%= t("billie.finance.ui.monthly_aggregate_totals_included_in_analysis") %></caption><thead><tr><th scope="col"><%= t("billie.finance.ui.month") %></th><th scope="col"><%= t("billie.finance.ui.income") %></th><th scope="col"><%= t("billie.finance.ui.expenses") %></th><th scope="col"><%= t("billie.finance.ui.net") %></th></tr></thead><tbody><% @snapshot[:monthly].last(12).each do |month| %><tr><td><%= finance_date(month[:month], "%b %Y") %></td><td><%= finance_money(month[:income], @profile.currency) %></td><td><%= finance_money(month[:expenses], @profile.currency) %></td><td><%= finance_money(month[:net], @profile.currency) %></td></tr><% end %></tbody></table></div></details></section>
<% if @insight.present? && @insight_stale %><div class="bw-stale-notice" role="status"><%= t("billie.finance.ui.your_records_or_profile_changed_since_this_analysis_was_generated_generate_a_new") %></div><% end %>
<% if @insight.present? %>
  <% content = @insight.content.with_indifferent_access %>
  <section class="bw-panel bw-section-gap"><div class="bw-panel-heading"><div><h2><%= t("billie.finance.ui.your_financial_outlook") %></h2><p><%= t("billie.finance.ui.generated") %> <%= finance_date(@insight.generated_at) %> · <%= @insight.source == "openai" ? t("billie.finance.ui.billie_insights") : t("billie.finance.ui.basic_analysis_rules_based") %></p></div><span class="bw-badge"><%= @insight.source == "openai" ? t("billie.finance.ui.billie_insights") : t("billie.finance.ui.basic_analysis") %></span></div><p class="bw-insight-summary"><%= content[:summary] %></p></section>
  <div class="bw-two-column bw-section-gap"><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.what_your_numbers_say") %></span><h2><%= t("billie.finance.ui.financial_observations") %></h2></div><%= finance_icon "forecast" %></div><div class="bw-insight-list"><% Array(content[:observations]).each do |item| %><article><span class="bw-insight-bullet"><%= finance_icon "transactions", size: 17 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div></section><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.small_steps_clearer_direction") %></span><h2><%= t("billie.finance.ui.actions_to_consider") %></h2></div><%= finance_icon "check" %></div><div class="bw-insight-list"><% Array(content[:actions]).each_with_index do |item, index| %><article><span class="bw-action-number"><%= format("%02d", index + 1) %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div></section></div>
<% else %>
  <section class="bw-panel bw-section-gap"><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "insights", size: 32 %></span><h3><%= t("billie.finance.ui.your_next_insight_is_in_your_numbers") %></h3><p><%= @snapshot[:transaction_count].zero? ? t("billie.finance.ui.upload_a_statement_review_your_categories_then_generate_your_first_analysis") : t("billie.finance.ui.generate_an_analysis_to_see_observations_and_actions_based_on_your_imported_tran") %></p></div></section>
<% end %>
<% if @tax_insight.present? && @tax_insight_stale %><div class="bw-stale-notice" role="status"><%= t("billie.finance.ui.your_records_or_profile_changed_since_billie_prepared_these_tax_insights_ask_bil") %></div><% end %>
<section class="bw-panel bw-section-gap" id="billie-tax-insights">
  <div class="bw-panel-heading">
    <div>
      <span class="bw-eyebrow"><%= t("billie.finance.ui.billie_insights_2") %></span>
      <h2><%= t("billie.finance.ui.tax_preparation") %></h2>
      <p><%= t("billie.finance.ui.billie_reviews_your_financial_summary_and_your_saved_tax_context_to_help_you_org") %></p>
    </div>
    <%= finance_icon "insights" %>
  </div>
  <% if @tax_insight.present? %>
    <% tax_content = @tax_insight.content.with_indifferent_access %>
    <p class="bw-caption"><%= t("billie.finance.ui.generated") %> <%= finance_date(@tax_insight.generated_at) %> <%= t("billie.finance.ui.billie_insights_2") %></p>
    <p class="bw-insight-summary"><%= tax_content[:summary] %></p>
    <div class="bw-two-column bw-section-gap">
      <div>
        <h3><%= t("billie.finance.ui.records_to_organize") %></h3>
        <div class="bw-insight-list">
          <% Array(tax_content[:tax_preparation]).each do |item| %>
            <article><span class="bw-check-outline"><%= finance_icon "check", size: 16 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article>
          <% end %>
        </div>
      </div>
      <div>
        <h3><%= t("billie.finance.ui.questions_for_your_tax_professional") %></h3>
        <div class="bw-insight-list">
          <% Array(tax_content[:questions]).each_with_index do |item, index| %>
            <article><span class="bw-action-number"><%= format("%02d", index + 1) %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article>
          <% end %>
        </div>
      </div>
    </div>
    <% if Array(tax_content[:limitations]).any? %><div class="bw-analysis-limitations"><strong><%= t("billie.finance.ui.keep_this_in_perspective") %></strong><ul><% Array(tax_content[:limitations]).each do |limitation| %><li><%= limitation %></li><% end %></ul></div><% end %>
  <% end %>
  <% if @ai_available %>
    <%= form_with url: generate_finance_insights_path, data: {turbo: false}, class: "bw-form bw-ai-form" do |form| %>
      <%= form.hidden_field :kind, value: "tax", id: nil %>
      <label class="bw-checkbox-inline"><%= form.check_box :consent, {required: true, id: "tax_consent"}, "1", "0" %><span><%= t("billie.finance.ui.analysis_consent", service: ai_service_name) %></span></label>
      <%= form.submit (@tax_insight.present? ? t("billie.finance.ui.ask_billie_again") : t("billie.finance.ui.ask_billie_for_tax_preparation_insights")), class: "bw-button bw-button-outline", disabled: @snapshot[:transaction_count].zero? %>
    <% end %>
    <% if @snapshot[:transaction_count].zero? %><p class="bw-caption"><%= t("billie.finance.ui.import_a_statement_first_so_billie_has_something_to_review") %></p><% end %>
  <% else %>
    <p class="bw-caption bw-ai-unavailable"><%= t("billie.finance.ui.billie_is_not_connected_yet_the_checklist_below_is_available_without_an_ai_servi") %></p>
  <% end %>
</section>
<div class="bw-two-column bw-section-gap"><section class="bw-panel"><div class="bw-panel-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.u_s_personal_tax_preparation") %></span><h2><%= t("billie.finance.ui.get_your_tax_records_ready") %></h2><p><%= t("billie.finance.ui.bank_deposits_are_not_automatically_taxable_income_this_is_a_preparation_checkli") %></p></div><%= finance_icon "file" %></div><% tax_items = @insight.present? ? Array(@insight.content.with_indifferent_access[:tax_preparation]) : [{title: t("billie.finance.ui.review_your_transaction_categories"), body: t("billie.finance.ui.check_uncategorized_transactions_transfers_and_any_business_related_items")}, {title: t("billie.finance.ui.gather_u_s_personal_tax_documents"), body: t("billie.finance.ui.collect_applicable_w_2_and_1099_forms_mortgage_or_student_loan_interest_statemen")}, {title: t("billie.finance.ui.review_federal_and_state_requirements"), body: t("billie.finance.ui.match_records_to_official_tax_documents_and_review_your_individual_circumstances")}] %><div class="bw-insight-list"><% tax_items.each do |item| %><article><span class="bw-check-outline"><%= finance_icon "check", size: 16 %></span><div><h3><%= item["title"] || item[:title] %></h3><p><%= item["body"] || item[:body] %></p></div></article><% end %></div><p class="bw-caption"><%= link_to t("billie.finance.ui.irs_gather_your_documents"), "https://www.irs.gov/filing/gather-your-documents", class: "bw-text-link", target: "_blank", rel: "noopener noreferrer" %></p><div class="bw-inline-actions"><%= link_to t("billie.finance.ui.review_flagged_transactions"), finance_transactions_path(kind: "review"), class: "bw-text-link" %><%= link_to t("billie.finance.ui.export_records"), finance_transactions_path(format: :csv), class: "bw-button bw-button-outline" %></div></section><section class="bw-panel bw-panel-soft"><div class="bw-panel-heading"><div><h2><%= t("billie.finance.ui.your_tax_context") %></h2><p><%= t("billie.finance.ui.preparation_guidance_depends_on_your_circumstances") %></p></div><%= finance_icon "settings" %></div><%= form_with model: @profile, scope: :finance_profile, url: finance_profile_path, method: :patch, data: {turbo: false}, class: "bw-form" do |form| %><%= hidden_field_tag :return_to, "insights" %><div class="bw-field"><%= form.label :tax_country, t("billie.finance.ui.tax_country_or_jurisdiction") %><%= form.text_field :tax_country, placeholder: t("billie.finance.ui.united_states"), maxlength: 100 %></div><div class="bw-field"><%= form.label :tax_profile, t("billie.finance.ui.financial_context") %><%= form.select :tax_profile, [[t("billie.finance.ui.not_specified"), ""], [t("billie.finance.ui.personal"), "personal"], [t("billie.finance.ui.self_employed"), "self_employed"], [t("billie.finance.ui.small_business"), "business"]] %></div><%= form.submit t("billie.finance.ui.save_tax_context"), class: "bw-button bw-button-outline" %><% end %><p class="bw-caption"><%= t("billie.finance.ui.this_information_adds_context_to_the_next_analysis_billieweather_does_not_calcul") %></p></section></div>
<% if @insight.present? && Array(@insight.content.with_indifferent_access[:limitations]).any? %><div class="bw-analysis-limitations"><strong><%= t("billie.finance.ui.keep_this_analysis_in_perspective") %></strong><ul><% Array(@insight.content.with_indifferent_access[:limitations]).each do |limitation| %><li><%= limitation %></li><% end %></ul></div><% end %>
<div class="bw-info-line"><%= finance_icon "file", size: 18 %><p><%= t("billie.finance.ui.analysis_can_be_incomplete_or_incorrect_it_is_for_financial_organization_and_gen") %></p></div>

<% content_for :title, "Review PDF statement" %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">YOU HAVE THE FINAL SAY</span><h1>Review your extracted transactions.</h1><p><%= @draft.filename %> <span class="bw-dot-divider">·</span> <%= @draft.currency %> <span class="bw-dot-divider">·</span> This draft expires after 30 minutes.</p></div><%= link_to "← Back to upload", finance_statements_path, class: "bw-text-link" %></div>
<div class="bw-review-notice"><span class="bw-feature-icon"><%= finance_icon "file", size: 25 %></span><div><h2>Check every row against your statement.</h2><p>PDF extraction can confuse dates, amounts, running balances, and deposit or withdrawal signs. Edit errors below, leave out summary lines, and confirm only the transactions you recognize. Positive amounts mean money in; negative amounts mean money out.</p><% if Array(@draft.warnings).any? %><details><summary>Extraction notes (<%= @draft.warnings.length %>)</summary><ul><% Array(@draft.warnings).each do |warning| %><li><%= warning %></li><% end %></ul></details><% end %></div></div>
<%= form_with url: confirm_finance_statement_draft_path(@draft), method: :post, data: {turbo: false}, class: "bw-form bw-section-gap" do |form| %>
  <section class="bw-panel bw-panel-flush"><div class="bw-panel-heading"><div><h2>Extracted rows</h2><p>Nothing appears in your dashboard until you confirm this import.</p></div><span class="bw-count"><%= @draft.rows.size %></span></div><div class="bw-table-scroll"><table class="bw-table bw-review-table"><thead><tr><th scope="col">Include</th><th scope="col">Date</th><th scope="col">Description</th><th scope="col">Signed amount (<%= @draft.currency %>)</th></tr></thead><tbody><% @draft.rows.each_with_index do |row, index| %><tr><td><%= hidden_field_tag "rows[#{index}][include]", "0", id: nil %><%= check_box_tag "rows[#{index}][include]", "1", (row["include"] || row[:include]).to_s != "0", "aria-label": "Include row #{index + 1}" %></td><td><%= date_field_tag "rows[#{index}][booked_on]", row["booked_on"] || row[:booked_on], "aria-label": "Date for row #{index + 1}" %></td><td><%= text_field_tag "rows[#{index}][description]", row["description"] || row[:description], maxlength: 500, "aria-label": "Description for row #{index + 1}" %></td><td><%= number_field_tag "rows[#{index}][amount]", row["amount"] || row[:amount], step: "0.01", placeholder: "Confirm sign and amount", "aria-label": "Signed amount for row #{index + 1}" %></td></tr><% end %></tbody></table></div></section>
  <label class="bw-checkbox-card bw-review-confirm"><%= check_box_tag :review_confirmed, "1", false, required: true %><span><strong>I reviewed the included rows against my statement.</strong><small>I checked the dates, descriptions, and signed amounts. Excluded rows will not be imported.</small></span></label>
  <div class="bw-form-footer"><%= link_to "Cancel import", finance_statements_path, class: "bw-text-link" %><%= form.submit "Confirm and import transactions", class: "bw-button bw-button-dark" %></div>
<% end %>

<% content_for :title, t("billie.finance.ui.review_pdf_statement") %>
<div class="bw-page-heading"><div><span class="bw-eyebrow"><%= t("billie.finance.ui.you_have_the_final_say") %></span><h1><%= t("billie.finance.ui.review_your_extracted_transactions") %></h1><p><%= @draft.filename %> <span class="bw-dot-divider">·</span> <%= @draft.currency %> <span class="bw-dot-divider">·</span> <%= t("billie.finance.ui.this_draft_expires_after_30_minutes") %></p></div><%= link_to t("billie.finance.ui.back_to_upload"), finance_statements_path, class: "bw-text-link" %></div>
<div class="bw-review-notice"><span class="bw-feature-icon"><%= finance_icon "file", size: 25 %></span><div><h2><%= t("billie.finance.ui.check_every_row_against_your_statement") %></h2><p><%= t("billie.finance.ui.pdf_extraction_can_confuse_dates_amounts_running_balances_and_deposit_or_withdra") %></p><% if Array(@draft.warnings).any? %><details><summary><%= t("billie.finance.ui.extraction_notes", count: @draft.warnings.length) %></summary><ul><% Array(@draft.warnings).each do |warning| %><li><%= Finance::PdfStatementExtractor.localized_warning(warning) %></li><% end %></ul></details><% end %></div></div>
<%= form_with url: confirm_finance_statement_draft_path(@draft), method: :post, data: {turbo: false}, class: "bw-form bw-section-gap" do |form| %>
  <section class="bw-panel bw-panel-flush"><div class="bw-panel-heading"><div><h2><%= t("billie.finance.ui.extracted_rows") %></h2><p><%= t("billie.finance.ui.nothing_appears_in_your_dashboard_until_you_confirm_this_import") %></p></div><span class="bw-count"><%= @draft.rows.size %></span></div><div class="bw-table-scroll"><table class="bw-table bw-review-table"><thead><tr><th scope="col"><%= t("billie.finance.ui.include") %></th><th scope="col"><%= t("billie.finance.ui.date") %></th><th scope="col"><%= t("billie.finance.ui.description") %></th><th scope="col"><%= t("billie.finance.ui.signed_amount_currency", currency: @draft.currency) %></th></tr></thead><tbody><% @draft.rows.each_with_index do |row, index| %><tr><td><%= hidden_field_tag "rows[#{index}][include]", "0", id: nil %><%= check_box_tag "rows[#{index}][include]", "1", (row["include"] || row[:include]).to_s != "0", "aria-label": t("billie.finance.ui.include_row", number: index + 1) %></td><td><%= date_field_tag "rows[#{index}][booked_on]", row["booked_on"] || row[:booked_on], "aria-label": t("billie.finance.ui.row_date", number: index + 1) %></td><td><%= text_field_tag "rows[#{index}][description]", row["description"] || row[:description], maxlength: 500, "aria-label": t("billie.finance.ui.row_description", number: index + 1) %></td><td><%= number_field_tag "rows[#{index}][amount]", row["amount"] || row[:amount], step: "0.01", placeholder: t("billie.finance.ui.confirm_sign_and_amount"), "aria-label": t("billie.finance.ui.row_signed_amount", number: index + 1) %></td></tr><% end %></tbody></table></div></section>
  <label class="bw-checkbox-card bw-review-confirm"><%= check_box_tag :review_confirmed, "1", false, required: true %><span><strong><%= t("billie.finance.ui.i_reviewed_the_included_rows_against_my_statement") %></strong><small><%= t("billie.finance.ui.i_checked_the_dates_descriptions_and_signed_amounts_excluded_rows_will_not_be_im") %></small></span></label>
  <div class="bw-form-footer"><%= link_to t("billie.finance.ui.cancel_import"), finance_statements_path, class: "bw-text-link" %><%= form.submit t("billie.finance.ui.confirm_and_import_transactions"), class: "bw-button bw-button-dark" %></div>
<% end %>

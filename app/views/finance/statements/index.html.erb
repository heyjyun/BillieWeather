<% content_for :title, "Upload statements" %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">FROM STATEMENTS TO CLARITY</span><h1>Bring your numbers together.</h1><p>Import a CSV or text-based PDF bank statement. We’ll organize the transactions into your financial picture.</p></div><%= link_to "View transactions →", finance_transactions_path, class: "bw-button bw-button-outline" %></div>
<div class="bw-two-column"><section class="bw-panel"><div class="bw-panel-heading"><div><h2>Upload a statement</h2><p>Your transactions are processed as you import</p></div><%= finance_icon "upload" %></div><%= form_with url: finance_statements_path, multipart: true, data: {turbo: false}, class: "bw-form" do |form| %><div class="bw-upload-box"><span class="bw-upload-icon"><%= finance_icon "upload", size: 32 %></span><h3>A clearer outlook is one file away.</h3><p>Choose a CSV export or text-based PDF from your bank.</p><%= form.label :file, "Statement CSV or PDF", class: "bw-sr-only" %><%= form.file_field :file, accept: ".csv,.pdf,text/csv,application/pdf", required: true, class: "bw-file-input" %><small>CSV up to 2 MB · text-based PDF · review PDF rows before importing</small></div><div class="bw-form-note"><%= finance_icon "file", size: 18 %><span>Transactions are saved to your account. The original file is not retained.</span></div><%= form.hidden_field :currency, value: @profile.currency %><div class="bw-field"><%= form.label :statement_year, "Statement year (for PDFs with short dates)" %><%= form.number_field :statement_year, value: Date.current.year, min: 1900, max: Date.current.year + 1, required: true %><small>Use the year printed on your PDF statement. Check cross-year dates in the review step.</small></div><div class="bw-form-footer"><span>Statement currency: <strong><%= @profile.currency %></strong></span><%= form.submit "Import statement", class: "bw-button bw-button-dark" %></div><% end %></section><aside class="bw-panel bw-panel-soft"><span class="bw-eyebrow">A QUICK GUIDE</span><h2>Before you upload</h2><ol class="bw-numbered-list"><li><strong>Export a statement from your bank</strong><p>CSV and text-based PDFs are supported. Scanned or image-only PDFs need a text-based PDF or CSV export; OCR is not available.</p></li><li><strong>CSV: check the columns</strong><p>Use Date, Description, and Amount. Separate Debit and Credit columns are also supported.</p></li><li><strong>PDF: review the extraction</strong><p>Every PDF goes through an editable review step. Income is positive; expenses are negative. CSV dates use YYYY-MM-DD or MM/DD/YYYY.</p></li><li><strong>Use one currency</strong><p>Your current workspace uses <%= @profile.currency %>. Currency conversion is not applied.</p></li></ol><%= link_to sample_finance_statements_path(format: :csv), class: "bw-button bw-button-outline bw-full-width" do %><%= finance_icon "file", size: 17 %> Download sample CSV<% end %><p class="bw-caption">Sample transactions are examples. Import them only if you want to try the workflow.</p></aside></div>
<section class="bw-panel bw-panel-flush bw-section-gap"><div class="bw-panel-heading"><div><h2>Statement history</h2><p>Your imported files and their transaction counts</p></div><span class="bw-count"><%= @statements.size %></span></div><% if @statements.any? %><div class="bw-table-scroll"><table class="bw-table"><thead><tr><th scope="col">Statement</th><th scope="col">Imported</th><th scope="col">Transactions</th><th scope="col">Status</th><th scope="col"><span class="bw-sr-only">Action</span></th></tr></thead><tbody><% @statements.each do |statement| %><tr><td><div class="bw-transaction-name"><span class="bw-transaction-icon"><%= finance_icon "file", size: 18 %></span><div><strong><%= statement.filename %></strong><small><%= statement.currency %></small></div></div></td><td class="bw-nowrap"><%= finance_date(statement.created_at) %></td><td><%= number_with_delimiter(statement.transaction_count) %></td><td><span class="bw-badge"><%= finance_icon "check", size: 13 %> Imported</span></td><td class="bw-text-right"><%= button_to "Remove", finance_statement_path(statement), method: :delete, class: "bw-danger-link", form: {data: {turbo: false}}, title: "Remove this statement and its transactions" %></td></tr><% end %></tbody></table></div><p class="bw-table-footnote">Removing a statement also removes all transactions imported from it.</p><% else %><div class="bw-empty-state"><span class="bw-empty-icon"><%= finance_icon "file", size: 32 %></span><h3>No statements yet.</h3><p>Upload your first statement to start connecting the dots.</p></div><% end %></section>

<% content_for :title, t("billie.finance.ui.upload_statements_2") %>

<div class="bw-page-heading">
  <div>
    <span class="bw-eyebrow"><%= t("billie.finance.ui.from_statements_to_clarity") %></span>
    <h1><%= t("billie.finance.ui.bring_your_numbers_together") %></h1>
    <p><%= t("billie.finance.ui.import_csv_or_text_based_pdf_bank_statements_together_we_ll_organize_the_transac") %></p>
  </div>
  <%= link_to t("billie.finance.ui.view_transactions"), finance_transactions_path, class: "bw-button bw-button-outline" %>
</div>

<% if @import_results.present? %>
  <section id="import-results" class="bw-panel bw-panel-flush bw-upload-results" aria-labelledby="import-results-title">
    <div class="bw-panel-heading">
      <div>
        <h2 id="import-results-title"><%= t("billie.finance.ui.your_upload_results") %></h2>
        <p><%= t("billie.finance.ui.each_file_is_processed_separately_a_failed_file_does_not_affect_successful_impor") %></p>
      </div>
      <span class="bw-count"><%= @import_results.size %></span>
    </div>
    <div class="bw-table-scroll">
      <table class="bw-table">
        <thead>
          <tr>
            <th scope="col"><%= t("billie.finance.ui.statement") %></th>
            <th scope="col"><%= t("billie.finance.ui.result") %></th>
            <th scope="col"><%= t("billie.finance.ui.transactions") %></th>
            <th scope="col"><%= t("billie.finance.ui.details") %></th>
            <th scope="col"><span class="bw-sr-only"><%= t("billie.finance.ui.action") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @import_results.each do |result| %>
            <tr data-import-status="<%= result[:status] %>" data-import-filename="<%= result[:filename] %>">
              <td><strong class="bw-import-filename"><%= result[:filename] %></strong></td>
              <td>
                <% if result[:status] == "imported" %>
                  <span class="bw-badge"><%= finance_icon "check", size: 13 %> <%= t("billie.finance.ui.imported") %></span>
                <% elsif result[:status] == "review" %>
                  <span class="bw-badge bw-badge-review"><%= t("billie.finance.ui.needs_review") %></span>
                <% else %>
                  <span class="bw-badge bw-badge-failed"><%= t("billie.finance.ui.not_imported") %></span>
                <% end %>
              </td>
              <td><%= result[:transaction_count].present? ? number_with_delimiter(result[:transaction_count]) : "—" %></td>
              <td class="bw-import-detail">
                <%= result[:message] %>
                <% if result[:date_column].present? %>
                  <small><%= t("billie.finance.ui.dates_use_column", column: result[:date_column]) %></small>
                <% end %>
              </td>
              <td class="bw-text-right">
                <% if result[:status] == "review" && result[:draft].present? %>
                  <%= link_to t("billie.finance.ui.review_2"), finance_statement_draft_path(result[:draft]), class: "bw-text-link" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="bw-table-footnote"><%= t("billie.finance.ui.retry_only_the_files_that_were_not_imported_pdfs_marked_needs_review_are_saved_b") %></p>
  </section>
<% end %>

<div class="bw-two-column">
  <section class="bw-panel">
    <div class="bw-panel-heading">
      <div>
        <h2><%= t("billie.finance.ui.upload_statements_2") %></h2>
        <p><%= t("billie.finance.ui.transactions_are_organized_and_categorized_automatically_as_you_import") %></p>
      </div>
      <%= finance_icon "upload" %>
    </div>
    <%= form_with url: finance_statements_path, multipart: true, data: {turbo: false}, class: "bw-form" do |form| %>
      <div class="bw-upload-box">
        <span class="bw-upload-icon"><%= finance_icon "upload", size: 32 %></span>
        <h3><%= t("billie.finance.ui.a_clearer_outlook_starts_here") %></h3>
        <p><%= t("billie.finance.ui.choose_one_or_more_csv_exports_or_text_based_pdfs_from_your_bank") %></p>
        <%= form.label :files, t("billie.finance.ui.statement_csv_or_pdf_files"), class: "bw-sr-only" %>
        <%= form.file_field :files, multiple: true, accept: ".csv,.pdf,text/csv,application/pdf", required: true, class: "bw-file-input", aria: {describedby: "statement-file-limits"} %>
        <small id="statement-file-limits"><%= t("billie.finance.ui.up_to_10_files_2_mb_per_file_10_mb_total_csv_and_text_based_pdf") %></small>
      </div>
      <div class="bw-form-note">
        <%= finance_icon "file", size: 18 %>
        <span><%= t("billie.finance.ui.each_file_has_its_own_result_transactions_are_saved_to_your_account_original_fil") %></span>
      </div>
      <% if @date_columns.present? %>
        <div class="bw-field">
          <%= form.label :date_column, t("billie.finance.ui.date_column_optional_override") %>
          <%= form.select :date_column, @date_columns.map { |column| [column, column] }, {include_blank: t("billie.finance.ui.automatic_transaction_date_first"), selected: params[:date_column]} %>
          <small><%= t("billie.finance.ui.automatic_detection_prefers_transaction_date_then_date_then_posting_dates_choose") %></small>
        </div>
      <% end %>
      <%= form.hidden_field :currency, value: @profile.currency %>
      <div class="bw-form-footer">
        <span><%= t("billie.finance.ui.statement_currency") %> <strong><%= @profile.currency %></strong></span>
        <%= form.submit t("billie.finance.ui.import_statements"), class: "bw-button bw-button-dark" %>
      </div>
    <% end %>
  </section>

  <aside class="bw-panel bw-panel-soft">
    <span class="bw-eyebrow"><%= t("billie.finance.ui.a_quick_guide") %></span>
    <h2><%= t("billie.finance.ui.before_you_upload") %></h2>
    <ol class="bw-numbered-list">
      <li>
        <strong><%= t("billie.finance.ui.choose_statements_from_your_bank") %></strong>
        <p><%= t("billie.finance.ui.select_several_files_at_once_including_a_mix_of_csvs_and_text_based_pdfs_scanned") %></p>
      </li>
      <li>
        <strong><%= t("billie.finance.ui.csv_check_the_columns") %></strong>
        <p><%= t("billie.finance.ui.use_date_description_and_amount_separate_debit_and_credit_columns_are_also_suppo") %></p>
        <p><%= t("billie.finance.ui.date_description_and_amount_import_transaction_activity_automatic_cash_balances") %></p>
      </li>
      <li>
        <strong><%= t("billie.finance.ui.pdf_review_anything_unclear") %></strong>
        <p><%= t("billie.finance.ui.pdfs_are_imported_automatically_when_everything_is_clear_including_the_statement") %></p>
      </li>
      <li>
        <strong><%= t("billie.finance.ui.bring_each_bank_account_together") %></strong>
        <p><%= t("billie.finance.ui.when_account_details_and_a_dated_balance_are_present_we_total_the_latest_balance") %></p>
      </li>
      <li>
        <strong><%= t("billie.finance.ui.use_one_currency") %></strong>
        <p><%= t("billie.finance.ui.workspace_currency", currency: @profile.currency) %></p>
      </li>
    </ol>
    <%= link_to sample_finance_statements_path(format: :csv), class: "bw-button bw-button-outline bw-full-width" do %>
      <%= finance_icon "file", size: 17 %> <%= t("billie.finance.ui.download_sample_csv") %>
    <% end %>
    <p class="bw-caption"><%= t("billie.finance.ui.sample_transactions_are_examples_import_them_only_if_you_want_to_try_the_workflo") %></p>
  </aside>
</div>

<% if @pending_drafts.present? %>
  <section id="pending-reviews" class="bw-panel bw-panel-flush bw-section-gap" aria-labelledby="pending-reviews-title">
    <div class="bw-panel-heading">
      <div>
        <h2 id="pending-reviews-title"><%= t("billie.finance.ui.pdfs_waiting_for_review") %></h2>
        <p><%= t("billie.finance.ui.check_each_pdf_s_extracted_rows_before_adding_its_transactions") %></p>
      </div>
      <span class="bw-count"><%= @pending_drafts.size %></span>
    </div>
    <div class="bw-table-scroll">
      <table class="bw-table">
        <thead>
          <tr>
            <th scope="col"><%= t("billie.finance.ui.statement") %></th>
            <th scope="col"><%= t("billie.finance.ui.extracted_rows") %></th>
            <th scope="col"><%= t("billie.finance.ui.review_expires") %></th>
            <th scope="col"><span class="bw-sr-only"><%= t("billie.finance.ui.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @pending_drafts.each do |draft| %>
            <tr data-pending-draft-id="<%= draft.id %>">
              <td>
                <div class="bw-transaction-name">
                  <span class="bw-transaction-icon"><%= finance_icon "file", size: 18 %></span>
                  <div><strong><%= draft.filename %></strong><small><%= draft.currency %> <%= t("billie.finance.ui.not_imported_yet") %></small></div>
                </div>
              </td>
              <td><%= number_with_delimiter(draft.rows.size) %></td>
              <td class="bw-nowrap"><%= time_tag draft.expires_at, t("billie.finance.ui.expires_in", duration: distance_of_time_in_words(Time.current, draft.expires_at)) %></td>
              <td>
                <div class="bw-review-actions">
                  <%= link_to t("billie.finance.ui.review_2"), finance_statement_draft_path(draft), class: "bw-text-link" %>
                  <%= button_to t("billie.finance.ui.discard"), finance_statement_draft_path(draft), method: :delete, class: "bw-danger-link", form: {data: {turbo: false}}, title: t("billie.finance.ui.discard_this_pdf_review") %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="bw-table-footnote"><%= t("billie.finance.ui.reviews_expire_30_minutes_after_upload_if_one_expires_upload_that_pdf_again_disc") %></p>
  </section>
<% end %>

<section class="bw-panel bw-panel-flush bw-section-gap" id="statement-history">
  <div class="bw-panel-heading">
    <div><h2><%= t("billie.finance.ui.statement_history") %></h2><p><%= t("billie.finance.ui.your_imported_files_accounts_and_transaction_counts") %></p></div>
    <span class="bw-count"><%= @statements.size %></span>
  </div>
  <% if @statements.any? %>
    <div class="bw-table-scroll">
      <table class="bw-table">
        <thead>
          <tr>
            <th scope="col"><%= t("billie.finance.ui.statement") %></th>
            <th scope="col"><%= t("billie.finance.ui.bank_account") %></th>
            <th scope="col"><%= t("billie.finance.ui.saved_balance") %></th>
            <th scope="col"><%= t("billie.finance.ui.imported") %></th>
            <th scope="col"><%= t("billie.finance.ui.transactions") %></th>
            <th scope="col"><%= t("billie.finance.ui.status") %></th>
            <th scope="col"><span class="bw-sr-only"><%= t("billie.finance.ui.action") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% @statements.each do |statement| %>
            <tr id="statement-<%= statement.id %>">
              <td>
                <div class="bw-transaction-name">
                  <span class="bw-transaction-icon"><%= finance_icon "file", size: 18 %></span>
                  <div><strong><%= statement.filename %></strong><small><%= statement.currency %></small></div>
                </div>
              </td>
              <td class="bw-statement-account">
                <% if statement.bank_account.present? %>
                  <strong><%= statement.bank_account.display_name %></strong>
                  <small class="bw-account-source"><%= statement.bank_account.kind == "credit" ? t("billie.finance.ui.credit_card_excluded_from_cash") : (statement.bank_account.kind == "cash" ? t("billie.finance.ui.cash_account") : t("billie.finance.ui.account_type_needs_confirmation")) %></small>
                <% else %>
                  <span class="bw-badge bw-badge-review"><%= t("billie.finance.ui.choose_account") %></span>
                  <small class="bw-account-source"><%= statement.closing_balance.nil? ? t("billie.finance.ui.account_unidentified_no_closing_balance_saved") : t("billie.finance.ui.not_included_in_automatic_cash_total") %></small>
                <% end %>
                <details class="bw-account-assignment">
                  <summary><%= statement.bank_account.present? ? t("billie.finance.ui.change_account") : t("billie.finance.ui.identify_this_account") %></summary>
                  <% if @bank_accounts.any? %>
                    <%= form_with url: finance_statement_path(statement), method: :patch, data: {turbo: false}, class: "bw-form" do %>
                      <div class="bw-field">
                        <%= label_tag "statement_#{statement.id}_bank_account_id", t("billie.finance.ui.use_an_existing_account") %>
                        <%= select_tag :bank_account_id, options_for_select(@bank_accounts.map { |account| [account.display_name, account.id] }, statement.bank_account_id), include_blank: t("billie.finance.ui.choose_account"), required: true, id: "statement_#{statement.id}_bank_account_id" %>
                      </div>
                      <%= submit_tag t("billie.finance.ui.use_this_account"), class: "bw-button bw-button-outline" %>
                    <% end %>
                    <p class="bw-caption"><%= t("billie.finance.ui.or_add_an_account") %></p>
                  <% end %>
                  <%= form_with url: finance_statement_path(statement), method: :patch, data: {turbo: false}, class: "bw-form" do %>
                    <div class="bw-field">
                      <%= label_tag "statement_#{statement.id}_bank_name", t("billie.finance.ui.bank_name") %>
                      <%= text_field_tag "bank_account[bank_name]", nil, required: true, maxlength: 100, placeholder: t("billie.finance.ui.e_g_chase"), id: "statement_#{statement.id}_bank_name" %>
                    </div>
                    <div class="bw-field">
                      <%= label_tag "statement_#{statement.id}_account_name", t("billie.finance.ui.account_label") %>
                      <%= text_field_tag "bank_account[name]", nil, required: true, maxlength: 100, placeholder: t("billie.finance.ui.e_g_everyday_checking"), id: "statement_#{statement.id}_account_name" %>
                    </div>
                    <div class="bw-field">
                      <%= label_tag "statement_#{statement.id}_last4", t("billie.finance.ui.last_four_account_digits") %>
                      <%= text_field_tag "bank_account[last4]", nil, required: true, inputmode: "numeric", pattern: "[0-9]{4}", minlength: 4, maxlength: 4, autocomplete: "off", id: "statement_#{statement.id}_last4" %>
                      <small><%= t("billie.finance.ui.use_the_same_bank_and_last_four_digits_for_every_statement_from_this_account_do") %></small>
                    </div>
                    <div class="bw-field">
                      <%= label_tag "statement_#{statement.id}_kind", t("billie.finance.ui.account_type") %>
                      <%= select_tag "bank_account[kind]", options_for_select([[t("billie.finance.ui.checking_savings_cash"), "cash"], [t("billie.finance.ui.credit_card"), "credit"]]), include_blank: t("billie.finance.ui.choose_account_type"), required: true, id: "statement_#{statement.id}_kind" %>
                    </div>
                    <% if @bank_accounts.any? %>
                      <div class="bw-field">
                        <%= label_tag "statement_#{statement.id}_separate_account", class: "bw-account-separate-label" do %>
                          <%= check_box_tag "bank_account[separate_account]", "1", false, id: "statement_#{statement.id}_separate_account" %>
                          <%= t("billie.finance.ui.this_is_a_different_account_with_the_same_bank_and_last_four_digits") %>
                        <% end %>
                      </div>
                    <% end %>
                    <%= submit_tag t("billie.finance.ui.save_account"), class: "bw-button bw-button-outline" %>
                  <% end %>
                </details>
              </td>
              <td>
                <% if statement.closing_balance.nil? %>
                  <span><%= t("billie.finance.ui.no_closing_balance_saved") %></span>
                <% else %>
                  <strong class="bw-nowrap"><%= finance_money(statement.closing_balance, statement.currency) %></strong>
                  <small class="bw-account-source"><%= statement.closing_balance_on.present? ? finance_date(statement.closing_balance_on) : t("billie.finance.ui.balance_date_not_saved") %></small>
                <% end %>
              </td>
              <td class="bw-nowrap"><%= finance_date(statement.created_at) %></td>
              <td><%= number_with_delimiter(statement.transaction_count) %></td>
              <td><span class="bw-badge"><%= finance_icon "check", size: 13 %> <%= t("billie.finance.ui.imported") %></span></td>
              <td class="bw-text-right"><%= button_to t("billie.finance.ui.remove"), finance_statement_path(statement), method: :delete, class: "bw-danger-link", form: {data: {turbo: false}}, title: t("billie.finance.ui.remove_this_statement_and_its_transactions") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="bw-table-footnote"><%= t("billie.finance.ui.statements_from_the_same_account_contribute_only_the_latest_balance_removing_a_s") %> <%= link_to t("billie.finance.ui.view_account_balances"), finance_forecast_path(anchor: "account-balances"), class: "bw-text-link" %></p>
  <% else %>
    <div class="bw-empty-state">
      <span class="bw-empty-icon"><%= finance_icon "file", size: 32 %></span>
      <h3><%= t("billie.finance.ui.no_statements_yet") %></h3>
      <p><%= t("billie.finance.ui.upload_your_first_statement_to_start_connecting_the_dots") %></p>
    </div>
  <% end %>
</section>

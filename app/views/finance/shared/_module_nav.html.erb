<%# The sidebar: modules the person shows (Settings › Feature Library, Finance::ModuleCatalog), then
    Settings, which is always shown. The sidebar is navigation only: a module that is not listed here
    still works and opens from the Feature Library. The same in Default and Manual Mode. Returned as
    JSON by FeatureLibraryController#update so a switch updates the sidebar without a reload. %>
<% settings_active = controller_name == "feature_library" || (controller_name == "settings" && action_name != "data") %>
<nav class="bw-nav bw-module-nav" id="module-nav" aria-label="<%= t('billie.modules.nav.main') %>">
  <% definitions = local_assigns.fetch(:sidebar) { sidebar_modules } %>
  <% active_module = local_assigns.fetch(:active_module) { current_module_id } %>
  <% if Finance::ModuleCatalog::TRANSACTION_MODULES.include?(active_module) && definitions.none? { |definition| definition.id == active_module } %>
    <% active_module = "transactions" %>
  <% end %>
  <div class="bw-business-nav">
    <% definitions.each do |definition| %>
      <%= finance_nav t("billie.modules.names.#{definition.id}"), public_send("#{definition.route}_path"), definition.icon, active: active_module == definition.id && !settings_active %>
    <% end %>
  </div>
  <%= finance_nav t('billie.modules.nav.settings'), finance_settings_path, "settings", active: settings_active %>
</nav>

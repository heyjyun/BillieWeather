<div class="bw-table-scroll"><table class="bw-table"><thead><tr><th scope="col">Transaction</th><th scope="col">Date</th><th scope="col">Category</th><th scope="col" class="bw-text-right">Amount</th><th scope="col"><span class="bw-sr-only">Action</span></th></tr></thead><tbody><% transactions.each do |transaction| %><tr><td><div class="bw-transaction-name"><span class="bw-transaction-icon <%= 'is-income' if transaction.amount.positive? %>"><%= finance_icon(transaction.amount.positive? ? "down" : "up", size: 18) %></span><div><strong><%= transaction.description %></strong><% if transaction.tax_review? %><small class="bw-review-label">Flagged for tax review</small><% elsif transaction.excluded? %><small>Excluded from totals</small><% end %></div></div></td><td class="bw-nowrap"><%= finance_date(transaction.booked_on, "%b %-d, %Y") %></td><td><span class="bw-category"><%= transaction.category %></span></td><td class="bw-text-right bw-nowrap bw-amount <%= 'bw-positive' if transaction.amount.positive? %>"><%= "+" if transaction.amount.positive? %><%= finance_money(transaction.amount, currency) %></td><td class="bw-text-right"><%= link_to "Review", edit_finance_transaction_path(transaction), class: "bw-table-link", "aria-label": "Review #{transaction.description}" %></td></tr><% end %></tbody></table></div>

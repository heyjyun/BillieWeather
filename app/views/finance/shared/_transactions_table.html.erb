<% selectable = local_assigns.fetch(:selectable, false) %>
<div class="bw-table-scroll"><table class="bw-table bw-tx-cards"><thead><tr><% if selectable %><th scope="col"><span class="bw-sr-only"><%= t("billie.ledger.batch.select") %></span></th><% end %><th scope="col"><%= t("billie.finance.ui.transaction") %></th><th scope="col"><%= t("billie.finance.ui.date") %></th><th scope="col"><%= t("billie.finance.ui.category") %></th><th scope="col" class="bw-text-right"><%= t("billie.finance.ui.amount") %></th><th scope="col"><span class="bw-sr-only"><%= t("billie.finance.ui.action") %></span></th></tr></thead><tbody><% transactions.each do |transaction| %><% incoming = transaction.amount.positive? %><tr id="entry-<%= transaction.id %>"><% if selectable %><td><input type="checkbox" name="ids[]" value="<%= transaction.id %>" form="batch-form" aria-label="<%= t("billie.ledger.batch.select_one", description: transaction.description) %>"></td><% end %><td><div class="bw-transaction-name"><span class="bw-transaction-icon <%= 'is-income' if incoming %>"><%= finance_icon(incoming ? "down" : "up", size: 18) %></span><div><strong><%= transaction.description %></strong><% if transaction.tax_review? %><small class="bw-review-label"><%= t("billie.finance.ui.flagged_for_tax_review") %></small><% elsif transaction.excluded? %><small><%= t("billie.finance.ui.excluded_from_totals") %></small><% end %><% if transaction.kind.present? && !%w[expense income].include?(transaction.kind) %><small class="bw-tag"><%= t("billie.ledger.kinds.#{transaction.kind}") %></small><% end %><% if transaction.edited_description? %><small class="bw-muted" title="<%= t("billie.ledger.entries.original") %>"><%= transaction.original_description %></small><% end %><% if transaction.merchant || transaction.project || transaction.tags.any? %><small class="bw-muted"><%= [transaction.merchant&.name, transaction.project&.name, *transaction.tags.map { |tag| "##{tag.name}" }].compact.join(" · ") %></small><% end %></div></div></td><td class="bw-nowrap"><%= finance_date(transaction.booked_on, "%b %-d, %Y") %></td><td><span class="bw-category"><%= finance_label(transaction.category) %></span></td><td class="bw-text-right bw-nowrap bw-amount <%= 'bw-positive' if incoming %>"><%= "+" if incoming %><%= finance_money(transaction.amount, currency) %></td><td class="bw-text-right"><%= link_to t("billie.finance.ui.review"), ((transaction.manual? && manual_mode?) ? edit_finance_entry_path(transaction) : edit_finance_transaction_path(transaction)), class: "bw-table-link", "aria-label": t("billie.finance.ui.review_transaction_description", description: transaction.description) %></td></tr><% end %></tbody></table></div>

<div class="bw-table-scroll"><table class="bw-table"><thead><tr><th scope="col"><%= t("billie.finance.ui.transaction") %></th><th scope="col"><%= t("billie.finance.ui.date") %></th><th scope="col"><%= t("billie.finance.ui.category") %></th><th scope="col" class="bw-text-right"><%= t("billie.finance.ui.amount") %></th><th scope="col"><span class="bw-sr-only"><%= t("billie.finance.ui.action") %></span></th></tr></thead><tbody><% transactions.each do |transaction| %><tr><td><div class="bw-transaction-name"><span class="bw-transaction-icon <%= 'is-income' if transaction.amount.positive? %>"><%= finance_icon(transaction.amount.positive? ? "down" : "up", size: 18) %></span><div><strong><%= transaction.description %></strong><% if transaction.tax_review? %><small class="bw-review-label"><%= t("billie.finance.ui.flagged_for_tax_review") %></small><% elsif transaction.excluded? %><small><%= t("billie.finance.ui.excluded_from_totals") %></small><% end %></div></div></td><td class="bw-nowrap"><%= finance_date(transaction.booked_on, "%b %-d, %Y") %></td><td><span class="bw-category"><%= finance_label(transaction.category) %></span></td><td class="bw-text-right bw-nowrap bw-amount <%= 'bw-positive' if transaction.amount.positive? %>"><%= "+" if transaction.amount.positive? %><%= finance_money(transaction.amount, currency) %></td><td class="bw-text-right"><%= link_to t("billie.finance.ui.review"), edit_finance_transaction_path(transaction), class: "bw-table-link", "aria-label": t("billie.finance.ui.review_transaction_description", description: transaction.description) %></td></tr><% end %></tbody></table></div>

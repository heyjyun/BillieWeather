<section class="bw-summary-preview bw-section-gap"><div><strong><%= t("billie.finance.ui.summary_used_for_analysis") %></strong><span><%= finance_period(@snapshot) %></span></div><dl><div><dt><%= t("billie.finance.ui.income") %></dt><dd><%= finance_money(@snapshot[:income], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.expenses") %></dt><dd><%= finance_money(@snapshot[:expenses], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.net_cash_flow") %></dt><dd><%= finance_money(@snapshot[:net], @profile.currency) %></dd></div><div><dt><%= t("billie.finance.ui.transactions") %></dt><dd><%= @snapshot[:transaction_count] %></dd></div></dl><details><summary><%= t("billie.finance.ui.categories_and_context") %></summary><p><%= t("billie.finance.ui.tax_jurisdiction") %> <%= (@profile.tax_country == "United States" ? t("billie.finance.ui.united_states") : @profile.tax_country.presence) || t("billie.finance.ui.not_specified") %> <%= t("billie.finance.ui.context") %> <%= (@profile.tax_profile.present? ? t("billie.finance.ui.tax_context_#{@profile.tax_profile}", default: @profile.tax_profile.humanize) : nil) || t("billie.finance.ui.not_specified") %></p><% @snapshot[:categories].each do |category| %><p><%= finance_label(category[:name]) %>: <%= finance_money(category[:amount], @profile.currency) %></p><% end %><p><%= t("billie.finance.ui.uncategorized") %> <%= @snapshot[:uncategorized_count] %> <%= t("billie.finance.ui.tax_review") %> <%= @snapshot[:tax_review_count] %> <%= t("billie.finance.ui.excluded") %> <%= @snapshot[:excluded_count] %> <%= t("billie.finance.ui.transfers") %> <%= @snapshot[:transfer_count] %></p><div class="bw-table-scroll"><table class="bw-table"><caption class="bw-sr-only"><%= t("billie.finance.ui.monthly_aggregate_totals_included_in_analysis") %></caption><thead><tr><th scope="col"><%= t("billie.finance.ui.month") %></th><th scope="col"><%= t("billie.finance.ui.income") %></th><th scope="col"><%= t("billie.finance.ui.expenses") %></th><th scope="col"><%= t("billie.finance.ui.net") %></th></tr></thead><tbody><% @snapshot[:monthly].last(12).each do |month| %><tr><td><%= finance_date(month[:month], "%b %Y") %></td><td><%= finance_money(month[:income], @profile.currency) %></td><td><%= finance_money(month[:expenses], @profile.currency) %></td><td><%= finance_money(month[:net], @profile.currency) %></td></tr><% end %></tbody></table></div></details></section>

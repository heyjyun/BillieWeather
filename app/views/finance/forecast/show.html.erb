<% content_for :title, "Cash flow forecast" %>
<div class="bw-page-heading"><div><span class="bw-eyebrow">MAKE ROOM FOR WHAT’S NEXT</span><h1>See a little further ahead.</h1><p>A simple projection of your cash balance if recent income and spending patterns continue.</p></div><span class="bw-pill"><%= finance_icon "forecast", size: 16 %> Estimate, not a guarantee</span></div>
<% if @forecast_error.present? %><div class="bw-flash bw-flash-error" role="alert"><%= @forecast_error %></div><% end %>
<div class="bw-metrics bw-metrics-three"><article class="bw-metric"><span>Starting cash balance</span><strong><%= finance_money(@forecast[:current_balance], @profile.currency) %></strong><small>The balance you provided below</small></article><article class="bw-metric bw-metric-mint"><span>Projected balance in <%= @forecast[:days] %> days</span><strong><%= finance_money(@forecast[:projected_balance], @profile.currency) %></strong><small>Based on <%= @forecast[:history_days] %> days of historical coverage</small></article><article class="bw-metric"><span>Average daily net cash flow</span><strong><%= finance_money(@forecast[:daily_income].to_d - @forecast[:daily_expenses].to_d, @profile.currency) %></strong><small>After your scenario adjustments</small></article></div>
<section class="bw-panel"><div class="bw-panel-heading"><div><h2>Your cash flow outlook</h2><p><%= finance_date(Date.current) %> – <%= finance_date(Date.current + @forecast[:days].to_i) %></p></div><span class="bw-legend"><span><i class="bw-legend-income"></i>Projected cash balance</span></span></div><% if @forecast[:points].present? %><div class="bw-line-chart"><div class="bw-chart-axis"><span><%= finance_money(@forecast[:points].map { |point| point[:balance] }.max, @profile.currency) %></span><span><%= finance_money(@forecast[:points].map { |point| point[:balance] }.min, @profile.currency) %></span></div><svg viewBox="0 0 800 250" role="img" aria-label="Projected balance from <%= finance_money(@forecast[:current_balance], @profile.currency) %> today to <%= finance_money(@forecast[:projected_balance], @profile.currency) %> in <%= @forecast[:days] %> days" preserveAspectRatio="none"><defs><linearGradient id="forecast-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#84c6af" stop-opacity="0.35"/><stop offset="100%" stop-color="#84c6af" stop-opacity="0.02"/></linearGradient></defs><path d="M20 60H780 M20 130H780 M20 210H780" fill="none" stroke="#e9ece9" stroke-width="1" stroke-dasharray="5 5"/><polygon points="20,230 <%= finance_chart_points(@forecast[:points]) %> 780,230" fill="url(#forecast-fill)"/><polyline points="<%= finance_chart_points(@forecast[:points]) %>" fill="none" stroke="#297b63" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/></svg></div><div class="bw-chart-dates"><span>Today</span><span>In <%= @forecast[:days] %> days</span></div><% end %><div class="bw-forecast-caveat"><%= finance_icon "file", size: 18 %><p>This line uses historical daily averages, not bill due dates or confirmed future payments. A short or incomplete statement history can make the estimate unreliable.</p></div></section>
<div class="bw-two-column bw-section-gap"><section class="bw-panel"><div class="bw-panel-heading"><div><h2>Explore a scenario</h2><p>Adjust the outlook without changing your actual transactions.</p></div><%= finance_icon "settings" %></div><%= form_with url: finance_forecast_path, method: :get, data: {turbo: false}, class: "bw-form" do |form| %><div class="bw-field"><%= form.label :days, "Forecast horizon" %><%= form.select :days, options_for_select([["Next 30 days", 30], ["Next 60 days", 60], ["Next 90 days", 90]], @forecast[:days]) %></div><div class="bw-form-grid"><div class="bw-field"><%= form.label :income_adjustment, "Income change (%)" %><%= form.number_field :income_adjustment, value: params[:income_adjustment].presence || 0, min: -100, max: 200, step: 1 %><small>Example: 10 means 10% more income.</small></div><div class="bw-field"><%= form.label :expense_adjustment, "Expense change (%)" %><%= form.number_field :expense_adjustment, value: params[:expense_adjustment].presence || 0, min: -100, max: 200, step: 1 %><small>Example: −10 means 10% less spending.</small></div></div><%= form.submit "Update forecast", class: "bw-button bw-button-dark" %><% end %></section><section class="bw-panel bw-panel-soft"><div class="bw-panel-heading"><div><h2>Set your starting point</h2><p>This is your current available cash, not your statement’s net flow.</p></div><%= finance_icon "wallet" %></div><%= form_with model: @profile, scope: :finance_profile, url: finance_profile_path, method: :patch, data: {turbo: false}, class: "bw-form" do |form| %><%= hidden_field_tag :return_to, "forecast" %><div class="bw-field"><%= form.label :current_balance, "Current cash balance (#{@profile.currency})" %><%= form.number_field :current_balance, step: "0.01", required: true %></div><%= form.submit "Save starting balance", class: "bw-button bw-button-outline" %><% end %><div class="bw-assumptions"><h3>What goes into this estimate</h3><ul><% Array(@forecast[:assumptions]).each do |assumption| %><li><%= assumption %></li><% end %></ul></div></section></div>

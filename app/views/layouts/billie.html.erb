<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · BillieWeather" : t('billie.layout.title') %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= t('billie.layout.description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="color-scheme" content="light dark">
    <%= stylesheet_link_tag "/billie-tokens.css" %>
    <%= stylesheet_link_tag "/billie.css" %>
    <script src="/billie-theme.js"></script>
    <script src="/billie.js" defer></script>
  <% landing_page = controller_path == "public/home"; public_page = landing_page || devise_controller? || !user_signed_in?; admin_area = !public_page && controller_path.start_with?("admin/"); demo_session = !public_page && current_user.demo_account? %>
  <%# The command bar (public/billie-command.*, built from packages/billie-commands) only on the signed-in finance pages. %>
  <% command_bar = !public_page && !admin_area && controller_path.start_with?("finance/") && !current_user.needs_usage_region? %>
  <% if command_bar %>
    <%= stylesheet_link_tag "/billie-command.css" %>
    <script src="/billie-command.js" defer></script>
  <% end %>
  </head>
  <body class="<%= public_page ? 'billie-public' : 'billie-app' %>">
    <a class="bw-skip-link" href="#main-content"><%= t('billie.layout.skip') %></a>
    <% if public_page %>
      <header class="bw-public-header">
        <%= link_to root_path, class: "bw-brand", "aria-label": t('billie.layout.home') do %><span class="bw-brand-mark">b<small>·</small></span><span>BillieWeather</span><% end %>
        <nav class="bw-public-links" aria-label="<%= t('billie.layout.main_navigation') %>"><%= link_to t('billie.community.nav.features_membership'), billie_features_path, "aria-current": ("page" if current_page?(billie_features_path)) %><%= link_to t('billie.layout.about_us'), billie_about_path, "aria-current": ("page" if current_page?(billie_about_path)) %><%= link_to t('billie.community.nav.support_us'), billie_features_path(anchor: "support"), class: "bw-public-support-link", data: {dialog_open: "support-dialog"}, "aria-haspopup": "dialog", "aria-controls": "support-dialog" %><%= link_to t('billie.downloads.nav'), billie_download_path, "aria-current": ("page" if current_page?(billie_download_path)) %></nav>
        <div class="bw-header-actions">
          <%= render 'shared/billie_theme_switcher' %>
          <%= render 'shared/billie_language_switcher' %>
          <% if user_signed_in? %><%= link_to t('billie.layout.open_dashboard'), finance_dashboard_path, class: "bw-button bw-button-dark" %><% else %><%= link_to t('billie.layout.log_in'), new_user_session_path, class: "bw-text-link" %><%= link_to t('billie.layout.get_started'), new_user_registration_path, class: "bw-button bw-button-dark" %><% end %>
        </div>
      </header>
    <% else %>
      <aside class="bw-sidebar" id="bw-sidebar">
        <div class="bw-sidebar-head">
          <%= link_to root_path, class: "bw-brand", "aria-label": t('billie.layout.home') do %><span class="bw-brand-mark">b<small>·</small></span><span class="bw-brand-name">BillieWeather</span><% end %>
          <button type="button" class="bw-sidebar-toggle" data-sidebar-toggle hidden aria-controls="bw-sidebar" aria-expanded="true" aria-label="<%= t('billie.layout.collapse_sidebar') %>" title="<%= t('billie.layout.collapse_sidebar') %>" data-collapse-label="<%= t('billie.layout.collapse_sidebar') %>" data-expand-label="<%= t('billie.layout.expand_sidebar') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6 M4 4v16"/></svg></button>
        </div>
        <% if admin_area %>
        <span class="bw-nav-label"><%= t('billie.community.nav.support_admin') %></span>
        <nav class="bw-nav" aria-label="<%= t('billie.community.nav.support_admin') %>">
          <%= finance_nav t('billie.community.nav.overview'), admin_root_path, "dashboard", active: controller_path == "admin/home" %>
          <%= finance_nav t('billie.community.nav.admin'), admin_community_path, "users", active: controller_path.start_with?("admin/community") %>
          <%= finance_nav t('billie.community.nav.payment_methods'), admin_payment_methods_path, "qr", active: controller_path == "admin/payment_methods" %>
          <%= link_to billie_features_path, class: "bw-nav-link", target: "_blank", rel: "noopener" do %><%= finance_icon "heart" %><span><%= t('billie.community.nav.membership') %> ↗</span><% end %>
          <%= link_to finance_dashboard_path, class: "bw-nav-link bw-nav-back" do %><%= finance_icon "arrow" %><span><%= t('billie.community.nav.back_to_app') %></span><% end %>
        </nav>
        <% else %>
        <div class="bw-workspace<%= ' bw-workspace-demo' if demo_session %>"><span class="bw-workspace-avatar" aria-hidden="true"><%= current_user.email.to_s.first.upcase %></span><div><strong><%= demo_session ? t('billie.quick_access.demo.heading') : t('billie.layout.my_workspace') %></strong><small><%= demo_session ? t('billie.quick_access.demo.synthetic_data') : t('billie.layout.personal_finances') %></small></div></div>
        <span class="bw-nav-label"><%= t('billie.layout.workspace_label') %></span>
        <nav class="bw-nav" aria-label="<%= t('billie.layout.workspace_navigation') %>">
          <%= finance_nav t('billie.layout.dashboard'), finance_dashboard_path, "dashboard", active: controller_name == "dashboard" %>
          <%= finance_nav t('billie.layout.statements'), finance_statements_path, "upload", active: controller_name == "statements" %>
          <%= finance_nav t('billie.layout.transactions'), finance_transactions_path, "transactions", active: controller_name == "transactions" %>
          <%= finance_nav t('billie.categories.nav'), finance_categories_path, "tag", active: controller_name == "categories" %>
          <%= finance_nav t('billie.layout.forecast'), finance_forecast_path, "forecast", active: controller_name == "forecast" %>
          <%= finance_nav t('billie.layout.insights'), finance_insights_path, "insights", active: controller_name == "insights" %>
          <%= finance_nav t('billie.layout.tax_preparation'), finance_tax_preparation_path, "file", active: controller_name == "tax_preparation" %>
          <%= finance_nav t('billie.region.nav'), finance_settings_path, "settings", active: controller_name == "settings" %>
        </nav>
        <% end %>
        <div class="bw-sidebar-bottom">
          <div class="bw-sidebar-note"><%= finance_icon "sun", size: 26 %><strong><%= t('billie.layout.clarity') %></strong><p><%= t('billie.layout.next_step') %></p></div>
          <div class="bw-user" aria-label="<%= t('billie.quick_access.signed_in_as', name: current_user.nickname.presence || current_user.email) %>"><div><span class="bw-user-kind"><%= demo_session ? t('billie.quick_access.demo.heading') : t('billie.quick_access.personal.heading') %></span><strong><%= demo_session ? t('billie.quick_access.demo.heading') : (current_user.nickname.presence || t('billie.layout.your_account')) %></strong><small title="<%= current_user.email unless demo_session %>"><%= demo_session ? t('billie.quick_access.demo.read_only_label') : current_user.email %></small></div><%= button_to destroy_user_session_path, method: :delete, class: "bw-icon-button", title: t('billie.layout.log_out'), form: {data: {turbo: false}}, "aria-label": t('billie.layout.log_out') do %><%= finance_icon "logout" %><% end %></div>
          <%= button_to t('billie.quick_access.switch_account'), destroy_user_session_path, method: :delete, params: {switch_account: 1}, class: "bw-sidebar-switch", id: "switch-account", form: {data: {turbo: false}} %>
        </div>
      </aside>
    <% end %>
    <div class="<%= public_page ? 'bw-public-shell' : 'bw-main-shell' %>">
      <% unless public_page %><header class="bw-topbar"><div class="bw-breadcrumb"><%= admin_area ? t('billie.community.nav.support_admin') : t('billie.layout.workspace') %> <span>/</span> <strong><%= content_for?(:title) ? yield(:title) : t('billie.layout.overview') %></strong></div><% if command_bar %><div class="bw-command" data-smart-command data-locale="<%= I18n.locale %>" data-context-url="<%= finance_command_context_path %>" data-preview-url="<%= finance_command_preview_path %>" data-execute-url="<%= finance_command_execute_path %>" data-undo-url="<%= finance_command_undo_path %>"></div><% end %><div class="bw-topbar-actions"><%= render 'shared/billie_theme_switcher' %><%= render 'shared/billie_language_switcher' %></div></header><% end %>
      <main id="main-content" class="<%= 'bw-main' unless public_page %>">
        <% if demo_session %><div class="bw-demo-banner" role="status" id="demo-banner"><div><strong><%= t('billie.quick_access.demo.banner_title') %></strong><span><%= t('billie.quick_access.demo.banner_body') %></span></div><%= button_to t('billie.quick_access.demo.exit'), destroy_user_session_path, method: :delete, params: {switch_account: 1}, class: "bw-button bw-button-small bw-button-outline", form: {data: {turbo: false}} %></div><% end %>
        <% flash.each do |type, message| %><div class="bw-flash <%= 'bw-flash-error' if type.to_s == 'alert' %>" role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
        <%= yield %>
      </main>
      <% if public_page %><%= render "community/support_dialog", **support_dialog_locals %><% end %>
      <% if public_page %><footer class="bw-public-footer"><span class="bw-brand">BillieWeather</span><p><%= t("billie.auth.home.disclaimer") %></p></footer><% end %>
      <% unless public_page %><footer class="bw-app-footer"><span>BillieWeather</span><span><%= t('billie.layout.footer') %></span></footer><% end %>
    </div>
  </body>
</html>

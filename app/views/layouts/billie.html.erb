<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · BillieWeather" : t('billie.layout.title') %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="<%= t('billie.layout.description') %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="color-scheme" content="light dark">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag "/billie-tokens.css" %>
    <%= stylesheet_link_tag "/billie.css" %>
    <%= stylesheet_link_tag "/searchable-select.css" %>
    <%= stylesheet_link_tag "/billie-overview.css" %>
    <script src="/billie-theme.js"></script>
    <script src="/billie.js" defer></script>
  <% landing_page = controller_path == "public/home"; public_page = landing_page || devise_controller? || !user_signed_in?; admin_area = !public_page && controller_path.start_with?("admin/") %>
  <%# The command bar (public/billie-command.*, built from packages/billie-commands) only on the signed-in finance pages. %>
  <% command_bar = !public_page && !admin_area && controller_path.start_with?("finance/") && !current_user.needs_usage_region? %>
  <%# Default Mode / Manual Mode switch (Finance::ManualWorkspace): finance pages only. %>
  <% mode_switch = command_bar && controller.is_a?(Finance::BaseController) %>
  <% manual_workspace = mode_switch && controller.send(:manual_mode?) %>
  <% if command_bar %>
    <%= stylesheet_link_tag "/billie-command.css" %>
    <script src="/billie-command.js" defer></script>
  <% end %>
  </head>
  <body class="<%= public_page ? 'billie-public' : 'billie-app' %><%= ' is-manual-mode' if manual_workspace %>"<% if mode_switch %> data-mode="<%= manual_workspace ? 'manual' : 'default' %>" data-draft-restored="<%= t('billie.ledger.mode.draft_restored') %>" data-draft-discard="<%= t('billie.ledger.mode.draft_discard') %>"<% end %>>
    <a class="bw-skip-link" href="#main-content"><%= t('billie.layout.skip') %></a>
    <% if public_page %>
      <header class="bw-public-header">
        <%= link_to root_path, class: "bw-brand", "aria-label": t('billie.layout.home') do %><%= render "shared/billie_brand_mark" %><span>BillieWeather</span><% end %>
        <nav class="bw-public-links" aria-label="<%= t('billie.layout.main_navigation') %>"><%= link_to t('billie.community.nav.features_membership'), billie_features_path, "aria-current": ("page" if current_page?(billie_features_path)) %><%= link_to t('billie.layout.about_us'), billie_about_path, "aria-current": ("page" if current_page?(billie_about_path)) %><%= link_to t('billie.community.nav.support_us'), billie_features_path(anchor: "support"), class: "bw-public-support-link", data: {dialog_open: "support-dialog"}, "aria-haspopup": "dialog", "aria-controls": "support-dialog" %><%= link_to t('billie.downloads.nav'), billie_download_path, "aria-current": ("page" if current_page?(billie_download_path)) %></nav>
        <div class="bw-header-actions">
          <%= render 'shared/billie_theme_switcher' %>
          <%= render 'shared/billie_language_switcher' %>
          <% if user_signed_in? %><%= link_to t('billie.layout.open_dashboard'), finance_dashboard_path, class: "bw-button bw-button-dark" %><% else %><%= link_to t('billie.layout.log_in'), new_user_session_path, class: "bw-text-link" %><%= link_to t('billie.layout.get_started'), new_user_registration_path, class: "bw-button bw-button-dark" %><% end %>
        </div>
      </header>
    <% else %>
      <aside class="bw-sidebar" id="bw-sidebar">
        <div class="bw-sidebar-head">
          <%= link_to root_path, class: "bw-brand", "aria-label": t('billie.layout.home') do %><%= render "shared/billie_brand_mark" %><span class="bw-brand-name">BillieWeather</span><% end %>
          <button type="button" class="bw-sidebar-toggle" data-sidebar-toggle hidden aria-controls="bw-sidebar" aria-expanded="true" aria-label="<%= t('billie.layout.collapse_sidebar') %>" title="<%= t('billie.layout.collapse_sidebar') %>" data-collapse-label="<%= t('billie.layout.collapse_sidebar') %>" data-expand-label="<%= t('billie.layout.expand_sidebar') %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6 M4 4v16"/></svg></button>
        </div>
        <% if admin_area %>
        <span class="bw-nav-label"><%= t('billie.community.nav.support_admin') %></span>
        <nav class="bw-nav" aria-label="<%= t('billie.community.nav.support_admin') %>">
          <%= finance_nav t('billie.community.nav.overview'), admin_root_path, "dashboard", active: controller_path == "admin/home" %>
          <%= finance_nav t('billie.community.nav.admin'), admin_community_path, "users", active: controller_path.start_with?("admin/community") %>
          <%= finance_nav t('billie.community.nav.payment_methods'), admin_payment_methods_path, "qr", active: controller_path == "admin/payment_methods" %>
          <%= link_to billie_features_path, class: "bw-nav-link", target: "_blank", rel: "noopener" do %><%= finance_icon "heart" %><span><%= t('billie.community.nav.membership') %> ↗</span><% end %>
          <%= link_to finance_dashboard_path, class: "bw-nav-link bw-nav-back" do %><%= finance_icon "arrow" %><span><%= t('billie.community.nav.back_to_app') %></span><% end %>
        </nav>
        <% else %>
        <div class="bw-workspace"><span class="bw-workspace-avatar" aria-hidden="true"><%= current_user.email.to_s.first.upcase %></span><div><strong><%= t('billie.layout.my_workspace') %></strong><small><%= t('billie.layout.personal_finances') %></small></div></div>
        <% if controller.is_a?(Finance::BaseController) %>
        <%= render "finance/shared/module_nav" %>
        <% else %>
        <%= render "finance/shared/module_nav", sidebar: Finance::ModuleCatalog.sidebar_modules(Finance::ModuleCatalog.choices_for(current_user), order: Finance::SidebarOrder.keys_for(current_user)), active_module: nil %>
        <% end %>
        <% end %>
        <div class="bw-sidebar-bottom">
          <div class="bw-user" aria-label="<%= t('billie.account_access.signed_in_as', name: current_user.nickname.presence || current_user.email) %>"><div><span class="bw-user-kind"><%= t('billie.account_access.account_kind') %></span><strong><%= link_to current_user.nickname.presence || t('billie.layout.your_account'), finance_settings_path(anchor: "settings-profile"), title: t("billie.modules.library.account") %></strong><small title="<%= current_user.email %>"><%= current_user.email %></small></div><%= button_to destroy_user_session_path, method: :delete, class: "bw-icon-button", title: t('billie.layout.log_out'), form: {data: {turbo: false}}, "aria-label": t('billie.layout.log_out') do %><%= finance_icon "logout" %><% end %></div>
          <%= button_to t('billie.account_access.switch_account'), destroy_user_session_path, method: :delete, params: {switch_account: 1}, class: "bw-sidebar-switch", id: "switch-account", form: {data: {turbo: false}} %>
        </div>
      </aside>
    <% end %>
    <div class="<%= public_page ? 'bw-public-shell' : 'bw-main-shell' %>">
      <% unless public_page %><header class="bw-topbar"><div class="bw-breadcrumb"><%= admin_area ? t('billie.community.nav.support_admin') : t('billie.layout.workspace') %> <span>/</span> <strong><%= content_for?(:title) ? yield(:title) : t('billie.layout.overview') %></strong></div><% if command_bar %><div class="bw-command" data-smart-command data-locale="<%= I18n.locale %>" data-context-url="<%= finance_command_context_path %>" data-preview-url="<%= finance_command_preview_path %>" data-execute-url="<%= finance_command_execute_path %>" data-undo-url="<%= finance_command_undo_path %>"></div><% end %><div class="bw-topbar-actions"><%= render 'shared/billie_mode_switch', manual: manual_workspace if mode_switch %><% if manual_workspace %><span class="bw-sr-only" id="manual-mode-badge"><%= t('billie.ledger.mode.manual_on') %></span><% end %><%= render 'shared/billie_theme_switcher' %><%= render 'shared/billie_language_switcher' %></div></header><% end %>
      <main id="main-content" class="<%= 'bw-main' unless public_page %>">
        <%# Only messages are shown; other flash keys (e.g. ai_batch_id) carry data for the page. %><% flash.to_hash.slice("notice", "alert").each do |type, message| %><div class="bw-flash <%= 'bw-flash-error' if type.to_s == 'alert' %>" role="<%= type.to_s == 'alert' ? 'alert' : 'status' %>"><%= message %></div><% end %>
        <% if controller.is_a?(Finance::BaseController) %><% module_id = controller.send(:current_module_id) %><% if Finance::ModuleCatalog::TRANSACTION_MODULES.include?(module_id) %><%= render "finance/shared/transactions_tabs" %><% elsif Finance::ModuleCatalog::WEB_TABS.key?(module_id) %><%= render "finance/shared/module_tabs" %><% end %><% end %>
        <%= yield %>
      </main>
      <% if public_page %><%= render "community/support_dialog", **support_dialog_locals %><% end %>
      <% if public_page %><footer class="bw-public-footer"><span class="bw-brand">BillieWeather</span><p><%= t("billie.auth.home.disclaimer") %></p></footer><% end %>
      <% unless public_page %><footer class="bw-app-footer"><span>BillieWeather</span><span><%= t('billie.layout.footer') %></span></footer><% end %>
    </div>
  </body>
</html>

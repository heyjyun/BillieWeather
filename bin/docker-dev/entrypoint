#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

bundle install
yarn install

# Check the local schema before starting the development processes.
if [ "${@: -1:1}" == "./bin/dev" ]; then
  if ! ./bin/rails db:abort_if_pending_migrations; then
    printf '%s\n' 'Prepare the local database explicitly with ./bin/rails db:prepare.' >&2
    exit 1
  fi
fi

exec "${@}"

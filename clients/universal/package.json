{
  "name": "billieweather-universal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BillieWeather for macOS, Windows, iOS and Android: one React + Tauri 2 codebase with local-first SQLite storage.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "desktop:dev": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "ios:init": "tauri ios init",
    "ios:build": "tauri ios build",
    "android:init": "tauri android init",
    "android:build": "tauri android build",
    "sync:translations": "cd ../.. && ruby clients/universal/scripts/sync-rails-translations.rb"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.1.0",
    "sql.js": "^1.15.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}

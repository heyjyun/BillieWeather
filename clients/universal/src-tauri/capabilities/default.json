{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege: local SQLite, a save dialog, writing only to the file the person picked, and opening BillieWeather web pages (sign-up, password reset) in the system browser.",
  "windows": [
    "main"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux",
    "iOS",
    "android"
  ],
  "permissions": [
    "core:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:allow-save",
    "fs:allow-write-file",
    "billie-ocr:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://localhost:3000/*"
        }
      ]
    }
  ]
}

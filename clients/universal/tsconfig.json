{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@billie/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@billie/finance-core": ["../../packages/finance-core/src/index.ts"],
      "@billie/reporting": ["../../packages/reporting/src/index.ts"],
      "@billie/design-tokens": ["../../packages/design-tokens/src/tokens.ts"],
      "@billie/commands": ["../../packages/billie-commands/src/index.ts"],
      "@nlae/core": ["../../packages/nl-action-engine/src/index.ts"],
      "@nlae/react": ["../../packages/nl-action-react/src/index.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "@testing-library/react": ["./node_modules/@testing-library/react/types/index.d.ts"]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "../../packages/*/src", "../../packages/*/test"]
}

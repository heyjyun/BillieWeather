{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@billie/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@billie/finance-core": ["../../packages/finance-core/src/index.ts"],
      "@billie/reporting": ["../../packages/reporting/src/index.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts", "../../packages/*/src", "../../packages/*/test"]
}

# Use config/application.yml locally or set these as Render environment variables.
# Never commit real secrets. Rails does not automatically load this file.
BASE_URL=http://localhost:3000
# Production Neon URL, with the database name and sslmode=require:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379/0
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=3
# Optional AI. Both values must be set; API usage is billed separately.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional HTTPS email delivery. Set a verified sender too.
POSTMARK_API_TOKEN=
MAIL_FROM=

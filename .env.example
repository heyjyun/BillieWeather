# Use config/application.yml locally or set these as Render environment variables.
# Never commit real secrets. Rails does not automatically load this file.
BASE_URL=http://localhost:3000
# Production Neon URL, with the database name and sslmode=require:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379/0
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=3
# Forecast default: prophet, chronos, or linear. Users can override this on /app/forecast.
FORECAST_ENGINE=prophet
# Chronos-2 runs in the separate billieforecast Python service.
BILLIEFORECAST_URL=http://127.0.0.1:8000
# Match the Python service key if authentication is enabled.
BILLIEFORECAST_API_KEY=
# Optional AI. Both values must be set; API usage is billed separately.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible proxy. Leave blank for the official OpenAI API.
# Prepend: https://prepend.me/api.openai.com/v1 (use its own key).
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=
# Optional native OpenAI fallback, only for an explicit Prepend credit/usage exhaustion error.
# Keep its key separate from the Prepend token; no fallback on auth, rate limits or outages.
OPENAI_FALLBACK_ON_QUOTA_EXHAUSTED=false
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_REASONING_EFFORT=
# Optional HTTPS email delivery. Set a verified sender too.
POSTMARK_API_TOKEN=
MAIL_FROM=
# Optional Google sign-in. Add both values and restart the server.
# Authorized redirect URI: http://localhost:3000/users/auth/google_oauth2/callback
# Also register your production HTTPS URL with the same callback path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
